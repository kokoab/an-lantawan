---
import IssueCover from '../../components/print/IssueCover.astro';
import PageHead from '../../components/site/PageHead.astro';
import Pagination from '../../components/stories/Pagination.astro';
import { parsePage } from '../../core/paging';
import { db } from '../../db/client';
import { type IssueKind, listIssues } from '../../db/queries/issues';
import Site from '../../layouts/Site.astro';
import { formatBytes, formatMonth } from '../../lib/format';
import { mediaUrl } from '../../lib/urls';

const KINDS: Array<{ value: IssueKind | null; label: string; param: string | null }> = [
  { value: null, label: 'All issues', param: null },
  { value: 'newsletter', label: 'Newsletters', param: 'newsletters' },
  { value: 'special', label: 'Special publications', param: 'special' },
];
const requested = Astro.url.searchParams.get('show');
const kind = KINDS.find((k) => k.param === requested) ?? KINDS[0];
const page = parsePage(Astro.url.searchParams.get('page'));
if (!page) return Astro.rewrite('/404');

// Page 1 shows the latest issue large, then eight more; later pages show eight.
const PER_PAGE = 8;
const result = await listIssues(db, {
  kind: kind.value,
  offset: page === 1 ? 0 : 1 + PER_PAGE * (page - 1),
  limit: page === 1 ? 1 + PER_PAGE : PER_PAGE,
});
const latest = page === 1 ? result.issues[0] : null;
const earlier = page === 1 ? result.issues.slice(1) : result.issues;
const pages = Math.max(1, Math.ceil(Math.max(0, result.total - 1) / PER_PAGE));
if (page > pages) return Astro.rewrite('/404');

const href = (param: string | null, p = 1) => {
  const u = new URLSearchParams();
  if (param) u.set('show', param);
  if (p > 1) u.set('page', String(p));
  const q = u.toString();
  return q ? `/print?${q}` : '/print';
};
const kindLabel = (k: IssueKind) => (k === 'newsletter' ? 'Newsletter' : 'Special publication');
---

<Site title="Print issues" description="An Lantawan newsletters and special publications, as they were printed.">
  <PageHead
    title="Print issues"
    intro="Newsletters and special publications, as they were printed. Open any issue to read it as a PDF."
    filters={KINDS.map((k) => ({ label: k.label, href: href(k.param), current: k === kind }))}
    filtersLabel="Show"
  />

  {
    result.total === 0 && (
      <section class="band framed empty-wrap">
        <div class="empty">
          <h2>No print issues yet</h2>
          <p>Newsletters and special publications show up here once the editorial team uploads them.</p>
          <a class="btn btn-secondary" href="/stories">
            Read the latest stories
          </a>
        </div>
      </section>
    )
  }

  {
    latest && (
      <section class="band framed latest" aria-labelledby="latest-issue">
        <a class="latest-cover" href={`/print/${latest.slug}`} tabindex="-1" aria-hidden="true">
          <IssueCover issue={latest} large />
        </a>
        <div class="latest-text">
          <p class="kicker">Latest issue: {kindLabel(latest.kind)}</p>
          <h2 id="latest-issue">
            <a href={`/print/${latest.slug}`}>{latest.title}</a>
          </h2>
          {latest.description && <p class="description">{latest.description}</p>}
          <dl class="facts">
            <div>
              <dt>Released</dt>
              <dd>{formatMonth(latest.publishedOn)}</dd>
            </div>
            <div>
              <dt>File</dt>
              <dd>PDF, {formatBytes(latest.pdfBytes)}</dd>
            </div>
          </dl>
          <div class="actions">
            <a class="btn btn-primary" href={`/print/${latest.slug}`}>
              Read the issue
            </a>
            <a class="btn btn-secondary" href={mediaUrl(latest.pdfKey)} download>
              Download PDF
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    earlier.length > 0 && (
      <section class="band framed archive" aria-labelledby="earlier-issues">
        <div class="archive-head">
          <h2 id="earlier-issues">{page === 1 ? 'Earlier issues' : `Page ${page}`}</h2>
          <p>
            {earlier.length} of {Math.max(0, result.total - 1)}
          </p>
        </div>
        <ul class="issues">
          {earlier.map((i) => (
            <li>
              <a href={`/print/${i.slug}`}>
                <IssueCover issue={i} />
                <span class="issue-title">{i.title}</span>
                <span class="issue-meta">
                  {kindLabel(i.kind)}, {formatMonth(i.publishedOn)}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <Pagination page={page} pages={pages} href={(p) => href(kind.param, p)} />
      </section>
    )
  }
</Site>

<style>
  h2,
  p,
  dl,
  dd {
    margin: 0;
  }
  .empty-wrap {
    padding-block: 32px 72px;
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding-block: 32px;
    border-top: 1px solid var(--grey-300);
  }
  .empty h2 {
    font-size: 28px;
    letter-spacing: -0.03em;
  }
  .empty p {
    margin-bottom: 8px;
    color: var(--grey-600);
  }
  .latest {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: 40px 56px;
  }
  .latest-cover {
    max-width: 400px;
  }
  .latest-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .kicker {
    font-size: 14px;
    font-weight: 500;
    color: var(--grey-600);
  }
  .latest h2 {
    font-size: 36px;
    font-weight: 700;
    line-height: 40px;
    letter-spacing: -0.04em;
  }
  .latest h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .description {
    max-width: 640px;
    font-size: 17px;
    line-height: 26px;
  }
  .facts {
    display: flex;
    gap: 40px;
    align-self: stretch;
    padding-top: 16px;
    border-top: 1px solid var(--grey-300);
  }
  .facts dt {
    font-size: 13px;
    color: var(--grey-600);
  }
  .facts dd {
    font-size: 15px;
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
  }
  .archive {
    padding-block: 48px 72px;
  }
  .archive-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 24px;
  }
  .archive-head h2 {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .archive-head p {
    font-size: 14px;
    color: var(--grey-600);
  }
  .issues {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .issues a {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .issue-title {
    margin-top: 12px;
    font-size: 17px;
    font-weight: 600;
    line-height: 22px;
    letter-spacing: -0.02em;
  }
  .issues a:hover .issue-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .issue-meta {
    font-size: 13px;
    color: var(--grey-600);
  }
  @media (min-width: 768px) {
    .issues {
      grid-template-columns: repeat(4, 1fr);
      gap: 40px 24px;
    }
  }
  @media (min-width: 1024px) {
    .latest {
      flex-direction: row;
      align-items: center;
      gap: 48px;
      padding-block: 64px 96px;
    }
    .latest-cover {
      flex: 0 0 calc((100% - 48px) * 432 / 1168);
      max-width: none;
    }
    .latest h2 {
      font-size: 52px;
      line-height: 56px;
    }
    .description {
      font-size: 20px;
      line-height: 30px;
    }
    .archive {
      padding-block: 64px 128px;
    }
    .archive-head h2 {
      font-size: 48px;
      line-height: 52px;
    }
  }
</style>
