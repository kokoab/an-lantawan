---
// Shown when something on the server fails. It uses no database queries, so it still
// works when the database is the thing that failed.
import Torch from '../components/Torch.astro';
import Base from '../layouts/Base.astro';
import '../styles/site.css';

Astro.response.status = 500;
---

<Base title="Something went wrong · An Lantawan" description="This page couldn’t load.">
  <header class="bar">
    <a class="lockup" href="/"><Torch class="mark" /><span>An Lantawan</span></a>
  </header>
  <main class="band framed error">
    <h1>This page didn’t load.</h1>
    <p>Something went wrong on our side, not yours. Try again in a minute. If it keeps happening, let us know through Sumat.</p>
    <div class="actions">
      <a class="btn btn-primary" href="">Try again</a>
      <a class="btn btn-secondary" href="/">Go to the homepage</a>
    </div>
  </main>
</Base>

<style>
  .bar {
    display: flex;
    align-items: center;
    height: 64px;
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--grey-300);
    background: var(--white);
  }
  .lockup {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .lockup :global(.mark) {
    width: 18.77px;
    height: 30px;
  }
  .error {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-block: 64px 96px;
  }
  h1 {
    margin: 0;
    font-size: 48px;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  p {
    max-width: 640px;
    margin: 0;
    font-size: 18px;
    line-height: 28px;
    color: var(--grey-600);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (min-width: 1024px) {
    .bar {
      height: 76px;
    }
    .error {
      padding-block: 128px 160px;
    }
    h1 {
      font-size: 104px;
      line-height: 100px;
    }
  }
</style>
