---
import { env } from 'cloudflare:workers';
import Torch from '../components/Torch.astro';
import { db } from '../db/client';
import { getSettings } from '../db/queries/settings';
import { currentPrompt } from '../db/queries/sumat';
import Base from '../layouts/Base.astro';

const prompt = await currentPrompt(db);
const settings = await getSettings(db, {
  'sumat.max_length': 500,
  'site.facebook_url': 'https://www.facebook.com/AnLantawanLNU',
});
const maxLength = settings['sumat.max_length'];
const turnstileSiteKey = env.TURNSTILE_SITE_KEY ?? '';

// The prompt changes when editors change it, so never serve a stale copy from a cache.
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base
  title="Sumat by An Lantawan"
  description="Say what's on your mind. Sumat is the open line of An Lantawan, the official student publication of Leyte Normal University."
  themeColor="#FFE400"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="page">
    <a class="brand" href="/" aria-label="An Lantawan home">
      <Torch />
      <b>Sumat</b><span>by An Lantawan</span>
    </a>

    {
      prompt ? (
        <form
          class="card"
          id="compose"
          novalidate
          data-max-length={maxLength}
          data-turnstile-site-key={turnstileSiteKey}
        >
          <p class="label">
            <span class="dot" aria-hidden="true" />
            Today's prompt
          </p>
          <h1 class="prompt">{prompt.text}</h1>

          <div class="field">
            <label for="message" class="hp">
              Your message
            </label>
            <textarea
              id="message"
              name="message"
              maxlength={maxLength}
              placeholder="Type it here. Be honest, be fair."
              aria-describedby="count"
            />
            <span class="count" id="count" aria-live="polite">
              0 / {maxLength}
            </span>
          </div>

          <div class="group" role="radiogroup" aria-labelledby="sendas-label">
            <p class="label" id="sendas-label">
              Send as
            </p>
            <div class="toggle">
              <button type="button" role="radio" aria-checked="true" data-identity="anonymous">
                Anonymous
              </button>
              <button type="button" role="radio" aria-checked="false" data-identity="named">
                With my name
              </button>
            </div>
          </div>

          <div class="named" id="named" hidden>
            <label>
              Your name
              <input id="name" name="name" maxlength="80" autocomplete="name" />
            </label>
            <label>
              <span>
                Course and year <span class="optional">(optional)</span>
              </span>
              <input id="course" name="course" maxlength="80" placeholder="e.g. BSEd English 3" />
            </label>
          </div>

          <div class="hp" aria-hidden="true">
            <label>
              Website
              <input id="website" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <div id="turnstile" class="turnstile" />

          <p class="error" id="error" role="alert" />
          <button class="btn btn-send" id="send" type="submit" disabled>
            Send it &rarr;
          </button>
          <p class="note">
            Only the An Lantawan editorial team reads this. Nothing is published without review.
          </p>
        </form>
      ) : (
        <section class="card">
          <p class="label">
            <span class="dot" aria-hidden="true" />
            Sumat is closed
          </p>
          <h1 class="prompt">We're not taking messages right now.</h1>
          <p class="note left">Follow An Lantawan on Facebook to see when the next prompt opens.</p>
        </section>
      )
    }

    <section class="sent" id="sent" hidden aria-live="polite">
      <div class="badge" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none">
          <path
            d="M5 12.5l4.5 4.5L19 7.5"
            stroke="#0A0A0A"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
      <h1 tabindex="-1" id="sent-title">Sent.</h1>
      <p class="lead">Your voice reached the newsroom.<br />Thanks for telling us.</p>
      <div class="actions">
        <button class="btn btn-dark" id="again" type="button">Send another</button>
        <a class="btn btn-outline" href={settings['site.facebook_url']} target="_blank" rel="noopener"
          >Follow An Lantawan on Facebook</a
        >
      </div>
      <p class="note" id="sent-as">Sent anonymously</p>
    </section>

    <footer>An Lantawan, the official student publication of Leyte Normal University</footer>
  </main>
</Base>

<script>
  import { initSumat } from '../scripts/sumat';

  initSumat();
</script>

<style is:global>
  /* Uses the licensed Tungsten Condensed Bold when installed on the device; everyone else gets Anton. */
  @font-face {
    font-family: 'Sumat Display';
    src: local('Tungsten Condensed Bold'), local('TungstenCond-Bold'), local('Tungsten Bold');
  }
  :root {
    --white: #ffffff;
    --ink: #0a0a0a;
    --grey-50: #fafafa;
    --grey-100: #f3f3f1;
    --grey-300: #d6d6d3;
    --grey-600: #6b6b68;
    --yellow: #ffe400;
    --yellow-deep: #ffc700;
    --sunrise: linear-gradient(180deg, var(--yellow) 0%, var(--yellow-deep) 100%);
    --error: #b42318;
    --font-ui: 'Helvetica Now Display', 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --font-display: 'Sumat Display', 'Anton', 'Helvetica Neue', Impact, sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  [hidden] {
    display: none !important;
  }
  html,
  body {
    margin: 0;
  }
  body {
    min-height: 100svh;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-ui);
    -webkit-font-smoothing: antialiased;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  button,
  input,
  textarea {
    font: inherit;
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
</style>

<style>
  .page {
    width: 100%;
    max-width: 440px;
    padding: 20px 16px 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (min-width: 720px) {
    .page {
      justify-content: center;
      padding-top: 48px;
      padding-bottom: 48px;
    }
  }
  .page > * {
    min-width: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }
  .brand :global(svg) {
    width: 22px;
    height: 35px;
    flex: none;
  }
  .brand b {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .brand span {
    font-size: 13px;
    color: var(--grey-600);
  }

  .card {
    background: var(--white);
    border: 1px solid var(--grey-300);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .label {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey-600);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sunrise);
    border: 1px solid var(--ink);
  }

  .prompt {
    margin: 0;
    font-size: 22px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .field {
    position: relative;
  }
  .field textarea {
    display: block;
    width: 100%;
    height: 168px;
    resize: vertical;
    min-height: 140px;
    padding: 16px 16px 36px;
    background: var(--grey-50);
    border: 1px solid var(--grey-300);
    border-radius: 14px;
    font-size: 16px;
    line-height: 1.5;
  }
  .field textarea::placeholder {
    color: var(--grey-600);
  }
  .count {
    position: absolute;
    right: 14px;
    bottom: 12px;
    font-size: 13px;
    color: var(--grey-600);
    pointer-events: none;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .toggle {
    display: flex;
    gap: 4px;
    padding: 4px;
    background: var(--grey-100);
    border: 1px solid var(--grey-300);
    border-radius: 999px;
  }
  .toggle button {
    flex: 1;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 11px 8px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: var(--grey-600);
  }
  .toggle button[aria-checked='true'] {
    background: var(--ink);
    color: var(--white);
  }

  .named {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .named label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
  }
  .named input {
    padding: 12px 14px;
    font-size: 16px;
    font-weight: 400;
    background: var(--grey-50);
    border: 1px solid var(--grey-300);
    border-radius: 12px;
  }
  .optional {
    font-weight: 400;
    color: var(--grey-600);
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 17px 24px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .btn-send {
    background: var(--sunrise);
    border: 1.5px solid var(--ink);
    color: var(--ink);
  }
  .btn-send:disabled {
    background: var(--grey-100);
    border-color: var(--grey-300);
    color: var(--grey-600);
    cursor: not-allowed;
  }
  .btn-dark {
    background: var(--ink);
    border: 1.5px solid var(--ink);
    color: var(--white);
  }
  .btn-outline {
    background: var(--white);
    border: 1px solid var(--grey-300);
    color: var(--ink);
  }

  .note {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--grey-600);
    text-align: center;
  }
  .note.left {
    text-align: left;
  }
  .error {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
    color: var(--error);
  }
  .error:empty {
    display: none;
  }
  /* Invisible bot check: keep its container out of the layout. */
  .turnstile {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .sent {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    padding: 24px 4px;
  }
  .badge {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background: var(--sunrise);
    border: 1.5px solid var(--ink);
    display: grid;
    place-items: center;
  }
  .sent h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 88px;
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: 0.005em;
  }
  .sent h1:focus {
    outline: none;
  }
  .sent p.lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.45;
  }
  .actions {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 12px;
  }

  footer {
    font-size: 12px;
    color: var(--grey-600);
    text-align: center;
    padding-top: 8px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .badge {
      animation: pop 420ms cubic-bezier(0.2, 0.8, 0.2, 1.2) both;
    }
    @keyframes pop {
      from {
        transform: scale(0.6);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
  }
</style>
