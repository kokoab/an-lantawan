---
import { env } from 'cloudflare:workers';
import TorchOnYellow from '../assets/torch-on-yellow.svg';
import { settingDefaults } from '../core/settings';
import { db } from '../db/client';
import { getSettings } from '../db/queries/settings';
import { currentPrompt } from '../db/queries/sumat';
import Site from '../layouts/Site.astro';

const prompt = await currentPrompt(db);
const settings = await getSettings(
  db,
  settingDefaults(
    'sumat.max_length',
    'site.facebook_url',
    'sumat.description',
    'sumat.note',
    'sumat.how',
    'sumat.sent_headline',
    'sumat.sent_body',
    'sumat.closed_headline',
    'sumat.closed_body',
  ),
);
const maxLength = settings['sumat.max_length'];
const facebookUrl = settings['site.facebook_url'];
const turnstileSiteKey = env.TURNSTILE_SITE_KEY ?? '';

// The prompt changes when editors change it, so never serve a stale copy from a cache.
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Site
  title="Sumat"
  description={settings['sumat.description']}
>
  {
    prompt ? (
      <>
        <section class="band yellow head" data-compose-part>
          <p class="brand">
            <TorchOnYellow class="mark" />
            <span class="name">Sumat</span>
            <span class="by">by An Lantawan</span>
          </p>
          <p class="kicker">Today’s prompt</p>
          <h1 class="prompt">{prompt.text}</h1>
        </section>

        <section class="band framed compose" data-compose-part>
          <form
            class="card"
            id="compose"
            novalidate
            data-max-length={maxLength}
            data-turnstile-site-key={turnstileSiteKey}
          >
            <div class="field">
              <label for="message">Your message</label>
              <textarea
                id="message"
                name="message"
                maxlength={maxLength}
                placeholder="Type it here. Be honest, be fair."
                aria-describedby="count"
              />
            </div>
            <p class="count" id="count" aria-live="polite">
              0 / {maxLength}
            </p>

            <div class="send-as" role="radiogroup" aria-labelledby="sendas-label">
              <p class="label" id="sendas-label">
                Send as
              </p>
              <div class="toggle">
                <button type="button" role="radio" aria-checked="true" data-identity="anonymous">
                  Anonymous
                </button>
                <button type="button" role="radio" aria-checked="false" data-identity="named">
                  With my name
                </button>
              </div>
            </div>

            <div class="named" id="named" hidden>
              <div class="field">
                <label for="name">Your name</label>
                <input id="name" name="name" maxlength="80" autocomplete="name" />
              </div>
              <div class="field">
                <label for="course">
                  Course and year <span class="optional">(optional)</span>
                </label>
                <input id="course" name="course" maxlength="80" placeholder="e.g. BSEd English 3" />
              </div>
            </div>

            <div class="hp" aria-hidden="true">
              <label>
                Website
                <input id="website" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <div id="turnstile" class="turnstile" />

            <p class="error" id="error" role="alert" />
            <button class="btn btn-sunrise send" id="send" type="submit" disabled>
              Send it →
            </button>
            <p class="note">{settings['sumat.note']}</p>
          </form>

          <aside class="how" aria-labelledby="how-title">
            <h2 id="how-title">How Sumat works</h2>
            <dl>
              {settings['sumat.how'].map((r) => (
                <div>
                  <dt>{r.title}</dt>
                  <dd>{r.text}</dd>
                </div>
              ))}
            </dl>
            <a class="text-link" href="/letters">Read published letters</a>
          </aside>
        </section>

        <section class="band yellow outcome" id="sent" hidden aria-live="polite">
          <p class="brand">
            <TorchOnYellow class="mark" />
            <span class="name">Sumat</span>
          </p>
          <h1 class="big" tabindex="-1" id="sent-title">Sent.</h1>
          <p class="headline">{settings['sumat.sent_headline']}</p>
          <p class="body">{settings['sumat.sent_body']}</p>
          <p class="sent-as" id="sent-as">Sent anonymously</p>
          <div class="actions">
            <button class="btn btn-primary" id="again" type="button">Send another</button>
            <a class="text-link" href={facebookUrl} target="_blank" rel="noopener">
              Follow An Lantawan on Facebook
            </a>
          </div>
        </section>
      </>
    ) : (
      <section class="band yellow outcome closed">
        <p class="brand">
          <TorchOnYellow class="mark small" />
          <span class="name">Sumat</span>
        </p>
        <h1 class="big">Sumat is closed</h1>
        <p class="headline">{settings['sumat.closed_headline']}</p>
        <p class="body">{settings['sumat.closed_body']}</p>
        <div class="actions">
          <a class="btn btn-primary" href="/letters">Read published letters</a>
          <a class="btn btn-secondary" href={facebookUrl} target="_blank" rel="noopener">
            Follow on Facebook
          </a>
        </div>
      </section>
    )
  }
</Site>

<script>
  import { initSumat } from '../scripts/sumat';

  initSumat();
</script>

<style>
  p,
  h1,
  h2,
  dl,
  dd {
    margin: 0;
  }

  .yellow {
    background: var(--sunrise);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand :global(.mark) {
    width: 22.53px;
    height: 36px;
    flex: none;
  }
  .brand :global(.mark.small) {
    width: 17.52px;
    height: 28px;
  }
  .name {
    font-size: 24px;
    font-weight: 700;
    line-height: 32px;
    letter-spacing: -0.03em;
  }
  .by {
    font-size: 15px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: -0.01em;
  }

  /* Prompt */
  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: 40px 54px;
  }
  .kicker {
    font-size: 15px;
    font-weight: 500;
    line-height: 22px;
    letter-spacing: -0.01em;
  }
  .prompt {
    font-size: 44px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    max-width: 1000px;
    text-wrap: pretty;
  }

  /* Compose */
  .compose {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 40px 59px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
    border: 1px solid var(--grey-300);
    background: var(--white);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  label,
  .label {
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    letter-spacing: -0.01em;
  }
  .optional {
    font-weight: 400;
    color: var(--grey-600);
  }
  textarea,
  input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--grey-300);
    border-radius: 0;
    background: var(--white);
    font-size: 16px;
    line-height: 22px;
    letter-spacing: -0.01em;
  }
  textarea {
    display: block;
    height: 200px;
    resize: vertical;
    font-size: 17px;
    line-height: 26px;
  }
  textarea::placeholder,
  input::placeholder {
    color: var(--grey-600);
  }
  textarea:focus,
  input:focus {
    outline: none;
    border-color: var(--ink);
  }
  .count {
    margin-top: -14px;
    align-self: flex-end;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    color: var(--grey-600);
  }
  .send-as {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .toggle {
    display: flex;
  }
  .toggle button {
    flex: 1;
    padding: 12px 18px;
    border: 1px solid var(--grey-300);
    background: var(--white);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    letter-spacing: -0.01em;
    cursor: pointer;
  }
  .toggle button + button {
    margin-left: -1px;
  }
  .toggle button[aria-checked='true'] {
    position: relative;
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }
  .named {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .named[hidden] {
    display: none;
  }
  .send {
    width: 100%;
  }
  .send:disabled {
    background: var(--grey-100);
    border-color: var(--grey-300);
    color: var(--grey-600);
    cursor: not-allowed;
  }
  .note {
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
  }
  .error {
    font-size: 15px;
    line-height: 20px;
    color: var(--red);
  }
  .error:empty {
    display: none;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  /* Invisible bot check: keep its container out of the layout. */
  .turnstile {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* How Sumat works */
  .how h2 {
    margin-bottom: 12px;
    font-size: 22px;
    font-weight: 700;
    line-height: 28px;
    letter-spacing: -0.03em;
  }
  .how dl > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-block: 16px;
    border-top: 1px solid var(--grey-300);
  }
  .how dt {
    font-size: 17px;
    font-weight: 600;
    line-height: 22px;
    letter-spacing: -0.01em;
  }
  .how dd {
    font-size: 15px;
    line-height: 22px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
  }
  .text-link {
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    letter-spacing: -0.01em;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Sent and closed */
  .outcome {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-block: 56px 54px;
  }
  .outcome[hidden] {
    display: none;
  }
  .big {
    font-size: 120px;
    font-weight: 700;
    line-height: 110px;
    letter-spacing: -0.06em;
  }
  .big:focus {
    outline: none;
  }
  .closed .big {
    font-size: 44px;
    line-height: 44px;
    letter-spacing: -0.05em;
  }
  .headline {
    font-size: 24px;
    font-weight: 700;
    line-height: 28px;
    letter-spacing: -0.03em;
  }
  .closed .headline {
    font-size: 18px;
    font-weight: 500;
    line-height: 26px;
    letter-spacing: -0.01em;
  }
  .body {
    font-size: 17px;
    line-height: 28px;
    letter-spacing: -0.01em;
  }
  .closed .body {
    font-size: 16px;
    line-height: 24px;
  }
  .sent-as {
    padding: 5px 10px;
    border: 1px solid var(--ink);
    background: var(--white);
    font-size: 13px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: -0.01em;
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    gap: 12px;
    padding-top: 16px;
  }
  .closed .actions {
    padding-top: 8px;
  }
  .actions .text-link {
    padding-top: 8px;
  }

  @media (min-width: 1024px) {
    .name {
      font-size: 28px;
      letter-spacing: -0.03em;
    }
    .head {
      gap: 20px;
      padding-block: 64px 82px;
    }
    .kicker {
      font-size: 17px;
    }
    .prompt {
      font-size: 88px;
      line-height: 86px;
    }
    .compose {
      flex-direction: row;
      align-items: flex-start;
      gap: 48px;
      padding-block: 56px 72px;
    }
    .card {
      flex: 0 0 calc((100% - 48px) * 768 / 1168);
      padding: 32px;
    }
    .how {
      flex: 1;
    }
    .how h2 {
      font-size: 24px;
    }
    textarea {
      height: 220px;
      font-size: 20px;
      line-height: 30px;
    }
    .toggle {
      align-self: flex-start;
    }
    .toggle button {
      flex: none;
    }
    .named {
      flex-direction: row;
    }
    .named .field {
      flex: 1;
    }
    .send {
      width: auto;
      align-self: flex-start;
    }
    .outcome {
      gap: 24px;
      padding-block: 96px 114px;
    }
    .closed {
      padding-bottom: 112px;
    }
    .big {
      font-size: 240px;
      line-height: 210px;
    }
    .closed .big {
      font-size: 96px;
      line-height: 92px;
    }
    .headline {
      font-size: 36px;
      line-height: 40px;
    }
    .closed .headline {
      font-size: 24px;
      line-height: 32px;
    }
    .body {
      font-size: 20px;
    }
    .closed .body {
      max-width: 640px;
      font-size: 18px;
      line-height: 26px;
    }
    .actions {
      flex-direction: row;
      align-items: center;
      align-self: flex-start;
    }
    .closed .actions {
      align-items: flex-start;
    }
    .actions .text-link {
      padding: 0 0 0 12px;
    }
  }
</style>
