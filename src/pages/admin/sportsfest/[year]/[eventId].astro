---
import CloseIcon from '../../../../assets/icons/admin/close.svg';
import AdminMatch from '../../../../components/admin/AdminMatch.astro';
import Field from '../../../../components/admin/Field.astro';
import TribuMark from '../../../../components/sportsfest/TribuMark.astro';
import { parseForm, toDateTimeInput } from '../../../../core/forms';
import { clearResult, recordResult } from '../../../../core/sportsfest/bracket';
import {
  categoryLabel,
  formatScore,
  groupCategories,
  pointsRuleText,
  roundName,
} from '../../../../core/sportsfest/display';
import {
  elimsAndPlayoffMedals,
  PLAYOFF_SIZES,
  planMatches,
  playoffDraw,
  playoffEntrants,
  readFormat,
} from '../../../../core/sportsfest/format';
import {
  bracketMedals,
  countsLoseMedals,
  countsToFinishes,
  finishesToCounts,
  type MedalCount,
  readFinishes,
  readMedalCounts,
  standingsFinishes,
} from '../../../../core/sportsfest/medals';
import { standings } from '../../../../core/sportsfest/standings';
import { db } from '../../../../db/client';
import {
  addCategory,
  addGroupMatch,
  applyBracket,
  bracketKey,
  createBracket,
  createRoundRobin,
  deleteCategory,
  deleteCompetition,
  deleteEvent,
  deleteMatch,
  deleteRound,
  eventHasResults,
  firstRound,
  getCompetition,
  getEventAdmin,
  getSportsfestRow,
  knockoutStarted,
  listAllTribus,
  listFinishes,
  recordGroupResult,
  renameCategory,
  saveFinishes,
  saveMedalCounts,
  setCustomMedals,
  setFirstRound,
  swapSlots,
  toBracket,
  updateEvent,
  updateMatchDetails,
  updateStageRule,
} from '../../../../db/queries/admin/sportsfest';
import Admin from '../../../../layouts/Admin.astro';
import { doneRedirect, editorOf, idParam, one, readForm, record } from '../../../../lib/admin';
import { categoryForm, eventForm, matchForm, pointsForm } from '../../../../lib/admin-schemas';
import {
  addMatchForm,
  buildStageViews,
  elimsTable,
  saveMatchesForm,
} from '../../../../lib/sportsfest-matches';
import { eventUrl } from '../../../../lib/urls';

const editor = editorOf(Astro);
const year = /^\d{4}$/.test(Astro.params.year ?? '') ? Number(Astro.params.year) : null;
const sf = year ? await getSportsfestRow(db, year) : null;
const eventId = idParam(Astro.params.eventId);
const event = sf && eventId ? await getEventAdmin(db, sf.id, eventId) : null;
if (!sf || !event) return Astro.rewrite('/404');

const requested = Number(Astro.url.searchParams.get('category'));
const category = event.categories.find((c) => c.id === requested) ?? event.categories[0] ?? null;
const base = `/admin/sportsfest/${sf.year}/${event.id}`;
const here = category ? `${base}?category=${category.id}` : base;
const allTribus = await listAllTribus(db);
const teams = allTribus.filter((t) => sf.tribuIds.includes(t.id));
const byId = new Map(allTribus.map((t) => [t.id, t]));

const name = (id: number | null) =>
  id === null ? 'To be decided' : (byId.get(id)?.name ?? 'Unknown tribu');

let eventValues: Record<string, unknown> = { ...event, startsAt: toDateTimeInput(event.startsAt) };
let errors: Record<string, string> = {};
let problem: string | null = null;
let setup: Record<string, string> = {
  elims: '0',
  playoffs: 'knockout',
  advance: '4',
  bronze: 'match',
};

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const intent = one(form, 'intent');
  const log = (summary: string) =>
    record(editor, { action: 'update', entityType: 'event', entityId: event.id, summary });

  if (intent === 'event') {
    eventValues = form;
    const parsed = parseForm(eventForm, form);
    if (parsed.ok) {
      const { categories: _, ...input } = parsed.data;
      await updateEvent(db, event.id, input);
      await log(`Edited ${input.name}, ${sf.name}`);
      return doneRedirect(Astro, here, 'saved');
    } else errors = parsed.errors;
  } else if (intent === 'delete-event') {
    if (await eventHasResults(db, event.id))
      problem =
        'This event has results or matches, so it can’t be deleted. Set it to Cancelled instead.';
    else {
      await deleteEvent(db, event.id);
      await log(`Deleted ${event.name} from ${sf.name}`);
      return doneRedirect(Astro, `/admin/sportsfest/${sf.year}`, 'deleted');
    }
  } else if (intent === 'add-category' || intent === 'rename-category') {
    const parsed = parseForm(categoryForm, form);
    if (!parsed.ok) problem = Object.values(parsed.errors)[0] ?? 'Check the category.';
    else if (intent === 'add-category') {
      await addCategory(db, event.id, parsed.data);
      await log(`Added the ${categoryLabel(parsed.data)} category to ${event.name}`);
      return doneRedirect(Astro, base, 'created');
    } else if (category) {
      await renameCategory(db, event.id, category.id, parsed.data);
      await log(`Renamed a category of ${event.name} to ${categoryLabel(parsed.data)}`);
      return doneRedirect(Astro, here, 'saved');
    }
  } else if (intent === 'delete-category' && category) {
    await deleteCategory(db, event.id, category.id);
    await log(`Removed the ${categoryLabel(category)} category from ${event.name}`);
    return doneRedirect(Astro, base, 'deleted');
  } else if (category && intent === 'results' && category.customMedals) {
    problem = 'This category uses custom medals. Reload the page to see them.';
  } else if (category && intent === 'results') {
    const r = readFinishes(
      teams.map((t) => ({
        tribuId: t.id,
        place: one(form, `place_${t.id}`),
        mark: one(form, `mark_${t.id}`),
      })),
      teams.length,
    );
    if (!r.ok) problem = r.error;
    else {
      await saveFinishes(db, category.id, r.finishes);
      await log(`Saved results of ${event.name}, ${categoryLabel(category)}`);
      return doneRedirect(Astro, here, 'result');
    }
  } else if (category && intent === 'medal-counts') {
    const r = readMedalCounts(
      teams.map((t) => ({
        tribuId: t.id,
        gold: one(form, `gold_${t.id}`),
        silver: one(form, `silver_${t.id}`),
        bronze: one(form, `bronze_${t.id}`),
      })),
    );
    if (!category.customMedals) problem = 'Turn on Customize medals first.';
    else if (!r.ok) problem = r.error;
    else {
      await saveMedalCounts(db, category.id, r.counts);
      await log(`Saved medals of ${event.name}, ${categoryLabel(category)}`);
      return doneRedirect(Astro, here, 'result');
    }
  } else if (category && intent === 'custom-medals') {
    const on = !category.customMedals;
    const current = await listFinishes(db, category.id);
    const rows = on
      ? finishesToCounts(current)
      : countsToFinishes(current as MedalCount[]).map((f) => ({ ...f, count: 1 }));
    await setCustomMedals(db, category.id, on, rows);
    await log(
      `${on ? 'Turned on' : 'Turned off'} custom medals for ${event.name}, ${categoryLabel(category)}`,
    );
    return doneRedirect(Astro, here, 'saved');
  } else if (category && intent === 'fill-results') {
    const comp = await getCompetition(db, category.id);
    const table = elimsTable(comp);
    const hasKnockout = comp.stages.some((st) => st.kind !== 'group');
    const inPlayoffs = firstRound(comp).flatMap((m) =>
      [m.homeTribuId, m.awayTribuId].filter((id): id is number => id !== null),
    );
    const finishes =
      table && hasKnockout
        ? elimsAndPlayoffMedals(bracketMedals(toBracket(comp)), table.rows, inPlayoffs)
        : table
          ? table.unplayed > 0
            ? null
            : standingsFinishes(table.rows)
          : bracketMedals(toBracket(comp));
    if (category.customMedals)
      problem = 'Turn off Customize medals to fill in places from the matches.';
    else if (!finishes)
      problem = 'Some matches haven’t been played yet, so the places can’t be filled in.';
    else {
      await saveFinishes(db, category.id, finishes);
      await log(`Filled in medals of ${event.name}, ${categoryLabel(category)} from the matches`);
      return doneRedirect(Astro, here, 'result');
    }
  } else if (category && intent === 'create-competition') {
    setup = Object.fromEntries(
      ['elims', 'playoffs', 'advance', 'bronze'].map((k) => [k, one(form, k)]),
    );
    const seeds = teams
      .map((_, i) => Number(one(form, `seed_${i + 1}`)))
      .filter((n) => teams.some((t) => t.id === n));
    const entrants = [...new Set(seeds)];
    const plan = readFormat(
      {
        elims: one(form, 'elims'),
        playoffs: one(form, 'playoffs'),
        advance: one(form, 'advance'),
        bronze: one(form, 'bronze'),
      },
      entrants.length,
    );
    const made = plan.ok ? planMatches(plan.value, entrants) : plan;
    const existing = await getCompetition(db, category.id);
    if (existing.stages.length) problem = 'This category already has matches. Reload the page.';
    else if (!plan.ok || !made.ok) problem = made.ok ? 'Check the format.' : made.error;
    else {
      const { elims, playoffs } = plan.value;
      if (elims > 0) {
        const rule = parseForm(pointsForm, form);
        await createRoundRobin(
          db,
          category.id,
          entrants,
          made.value.rounds,
          rule.ok ? rule.data : { win: 3, draw: 1, loss: 0 },
          playoffs !== 'none' ? 'Elims' : elims === 2 ? 'Double round robin' : 'Round robin',
        );
      }
      if (made.value.bracket.length) {
        await createBracket(db, category.id, made.value.bracket, {
          firstSort: elims > 0 ? 1 : 0,
          playoffs: elims > 0,
        });
      }
      await log(`Set up the matches of ${event.name}, ${categoryLabel(category)}`);
      return doneRedirect(Astro, here, 'generated');
    }
  } else if (category && intent === 'send-to-playoffs') {
    const comp = await getCompetition(db, category.id);
    const table = elimsTable(comp);
    const round = firstRound(comp);
    const double = comp.stages.some((st) => st.kind === 'upper');
    // Without an upper bracket, a "final" stage is the third-place match (see bracketKey).
    const third = !double && comp.stages.some((st) => st.kind === 'final');
    if (!table || !round.length) problem = 'This category has no elims and playoffs.';
    else if (knockoutStarted(comp))
      problem = 'A playoff match already has a result, so the playoff tribus are fixed.';
    else {
      const top = playoffEntrants(table.rows, round.length * 2, table.unplayed);
      const draw = top.ok ? playoffDraw(double ? 'double' : 'knockout', top.value, third) : top;
      if (!draw.ok) problem = draw.error;
      else {
        await setFirstRound(db, comp, draw.value);
        await log(
          `Sent the top ${round.length * 2} of ${event.name}, ${categoryLabel(category)} to the playoffs`,
        );
        return doneRedirect(Astro, `${here}#draw`, 'advanced');
      }
    }
  } else if (category && intent === 'swap') {
    const comp = await getCompetition(db, category.id);
    const round = firstRound(comp);
    const read = (v: string) => {
      const [id, slot] = v.split(':');
      const m = round.find((x) => x.id === Number(id));
      if (!m || (slot !== 'home' && slot !== 'away')) return null;
      return {
        id: m.id,
        slot,
        tribuId: slot === 'home' ? m.homeTribuId : m.awayTribuId,
        match: m,
      } as const;
    };
    const a = read(one(form, 'from'));
    const b = read(one(form, 'to'));
    if (a && b && a.id === b.id && a.slot === b.slot) return Astro.redirect(`${here}#draw`, 303);
    if (!a || !b) problem = 'Those places are no longer in the draw. Reload the page.';
    else if (knockoutStarted(comp))
      problem =
        'A match already has a result, so the draw is fixed. Change tribus in each match instead.';
    else if (a.match.status === 'bye' || b.match.status === 'bye')
      problem = 'A bye can’t be swapped. Set up the matches again to change who gets the bye.';
    else {
      await swapSlots(db, a, b);
      await log(`Changed the draw of ${event.name}, ${categoryLabel(category)}`);
      return doneRedirect(Astro, `${here}#draw`, 'swapped');
    }
  } else if (category && intent === 'delete-competition') {
    await deleteCompetition(db, category.id);
    await log(`Removed the matches of ${event.name}, ${categoryLabel(category)}`);
    return doneRedirect(Astro, here, 'deleted');
  } else if (category && intent === 'points') {
    const rule = parseForm(pointsForm, form);
    const stageId = Number(one(form, 'stageId'));
    if (!rule.ok) problem = 'Points must be numbers from 0 to 10.';
    else {
      await updateStageRule(db, stageId, rule.data);
      return doneRedirect(Astro, here, 'saved');
    }
  } else if (category && intent === 'save-matches') {
    const r = await saveMatchesForm(form, category.id, name);
    if (r.ok) {
      if (r.summary) await log(`${r.summary} of ${event.name}, ${categoryLabel(category)}`);
      return doneRedirect(Astro, `${here}#stage-${r.stageId}`, r.done);
    }
    problem = r.problem;
  } else if (category && intent === 'add-match') {
    const r = await addMatchForm(form, category.id, teams);
    if (r.ok) {
      await log(`${r.summary} of ${event.name}, ${categoryLabel(category)}`);
      return doneRedirect(Astro, `${here}#stage-${r.stageId}`, 'created');
    }
    problem = r.problem;
  }
  Astro.response.status = 422;
}

const [finishes, comp] = category
  ? await Promise.all([listFinishes(db, category.id), getCompetition(db, category.id)])
  : [[], null];
const placeOf = new Map(finishes.map((f) => [f.tribuId, f]));
const countOf = (tribuId: number, place: number) =>
  finishes.find((f) => f.tribuId === tribuId && f.place === place)?.count ?? 0;
const custom = category?.customMedals ?? false;
const draw = comp ? firstRound(comp) : [];
const drawLocked = comp ? knockoutStarted(comp) : false;
const hasElims = comp?.stages.some((st) => st.kind === 'group') ?? false;
const sizes = PLAYOFF_SIZES.filter((n) => n <= Math.max(2, teams.length)).map((n) => ({
  value: String(n),
  label: n === 2 ? 'Top 2 (a final)' : n === 4 ? 'Top 4 (semifinals and a final)' : `Top ${n}`,
}));
const losesMedals = custom && countsLoseMedals(finishes as MedalCount[]);
const ev = (k: string) => (eventValues[k] ?? '') as string;
const TYPES = [
  { value: 'bracket', label: 'Matches between tribus' },
  { value: 'race', label: 'Timed or measured' },
  { value: 'judged', label: 'Judged' },
  { value: 'mind', label: 'Ranked' },
];
const STATUSES = [
  { value: 'scheduled', label: 'Scheduled' },
  { value: 'ongoing', label: 'Ongoing' },
  { value: 'done', label: 'Done' },
  { value: 'postponed', label: 'Postponed' },
  { value: 'cancelled', label: 'Cancelled' },
];
const table = comp ? elimsTable(comp) : null;
const drawIds = new Set(draw.map((m) => m.id));
const stageViews = comp ? buildStageViews(comp) : [];
const elims = stageViews.filter((sv) => sv.stage.kind === 'group');
const knockout = stageViews.filter((sv) => sv.stage.kind !== 'group');
const deletable = !(await eventHasResults(db, event.id));
const lastRound = (sv: (typeof stageViews)[number]) => sv.rounds[sv.rounds.length - 1]?.round ?? 1;
const medalLabel = (p: number) => ['', 'Gold', 'Silver', 'Bronze'][p] ?? '';
---

<Admin title={event.name} section="sportsfest" back={{ label: sf.name, href: `/admin/sportsfest/${sf.year}` }}>
  <Fragment slot="actions">
    <a class="btn btn-secondary" href={eventUrl(sf.year, event.slug, category?.id)} target="_blank" rel="noopener">View on site</a>
    <button class="btn btn-danger" type="button" data-open-dialog="delete-event">Delete event</button>
  </Fragment>
  <dialog class="dialog" id="delete-event" aria-labelledby="delete-title" slot="dialogs">
    <form method="post">
      <input type="hidden" name="intent" value="delete-event" />
      <div class="dialog-head">
        <div>
          <h2 id="delete-title">{deletable ? `Delete ${event.name}?` : `${event.name} can’t be deleted`}</h2>
          <p>
            {deletable
              ? 'It disappears from the site. This can’t be undone.'
              : 'It has results or matches. To take it off the schedule, set its status to Cancelled instead.'}
          </p>
        </div>
        <button type="button" class="dialog-close" aria-label="Close" data-close-dialog><CloseIcon /></button>
      </div>
      <div class="dialog-actions">
        <button class="btn btn-secondary" type="button" data-close-dialog>{deletable ? 'Keep it' : 'Close'}</button>
        {deletable && <button class="btn btn-danger" type="submit">Delete event</button>}
      </div>
    </form>
  </dialog>
  {problem && <p class="admin-error-summary" role="alert">{problem}</p>}

  {event.categories.length > 1 && (<nav class="tabs" aria-label="Categories">
    {groupCategories(event.categories).map((g) => (
      <div class="tab-group">
        {g.heading && <span class="tab-heading">{g.heading}</span>}
        {g.categories.map((c) => (
          <a class:list={['btn', c.id === category?.id ? 'btn-primary' : 'btn-secondary']} href={`${base}?category=${c.id}`} aria-current={c.id === category?.id ? 'page' : undefined}>
            {c.name}
          </a>
        ))}
      </div>
    ))}
  </nav>)}

  <div class="columns main-side">
    <div>
      {
        category && (
          <>
            <section class="panel">
              <div class="panel-head">
                <h2>Results: {categoryLabel(category)}</h2>
                <form method="post">
                  <input type="hidden" name="intent" value="custom-medals" />
                  <button
                    class="switch-button"
                    type="submit"
                    role="switch"
                    aria-checked={custom ? 'true' : 'false'}
                    data-confirm={losesMedals ? 'Go back to one place per tribu? Each tribu keeps only its best medal here.' : undefined}
                  >
                    <span class="track" aria-hidden="true"></span>
                    Customize medals
                  </button>
                </form>
              </div>
              {custom ? (
                <form method="post">
                  <p class="muted small">Enter how many golds, silvers and bronzes each tribu won here, like 1 gold and 2 silvers in swimming. Leave a box empty for none.</p>
                  <input type="hidden" name="intent" value="medal-counts" />
                  <div class="table-wrap">
                    <table class="table">
                      <thead><tr><th scope="col">Tribu</th><th scope="col">Gold</th><th scope="col">Silver</th><th scope="col">Bronze</th></tr></thead>
                      <tbody>
                        {teams.map((t) => (
                          <tr>
                            <th scope="row"><span class="tribu"><TribuMark tribu={t} size="xs" />{t.name}</span></th>
                            {(['gold', 'silver', 'bronze'] as const).map((medal, i) => (
                              <td class="count">
                                <input type="number" name={`${medal}_${t.id}`} min="0" max="99" step="1" inputmode="numeric" value={countOf(t.id, i + 1) || ''} aria-label={`${medal[0].toUpperCase()}${medal.slice(1)} medals of ${t.name}`} />
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <div class="form-actions"><button class="btn btn-primary" type="submit">Save medals</button></div>
                </form>
              ) : (
                <form method="post">
                  <p class="muted small">Places 1 to 3 are the medals. Ties can share a place. Results are optional, like 12.84 seconds.</p>
                  <input type="hidden" name="intent" value="results" />
                  <div class="table-wrap">
                    <table class="table">
                      <thead><tr><th scope="col">Tribu</th><th scope="col">Place</th><th scope="col">Time, distance or score</th></tr></thead>
                      <tbody>
                        {teams.map((t) => {
                          const f = placeOf.get(t.id);
                          return (
                            <tr>
                              <th scope="row"><span class="tribu"><TribuMark tribu={t} size="xs" />{t.name}</span></th>
                              <td class="place">
                                <select name={`place_${t.id}`} aria-label={`Place of ${t.name}`}>
                                  <option value="">No place</option>
                                  {teams.map((_, i) => (
                                    <option value={i + 1} selected={f?.place === i + 1}>
                                      {i + 1}{i < 3 ? ` (${medalLabel(i + 1)})` : ''}
                                    </option>
                                  ))}
                                </select>
                              </td>
                              <td><input type="text" name={`mark_${t.id}`} value={f?.mark ?? ''} maxlength="60" aria-label={`Result of ${t.name}`} /></td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                  <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Save results</button>
                    {comp && comp.stages.length > 0 && (
                      <button class="btn btn-secondary" type="submit" name="intent" value="fill-results" data-confirm="Replace the places above with the ones the matches decided?">
                        Fill in from the matches
                      </button>
                    )}
                  </div>
                </form>
              )}
            </section>

            <section class="panel">
              <h2>Matches</h2>
              {comp && comp.stages.length === 0 ? (
                <form class="form" method="post">
                  <p class="panel-note">Events decided by time, judges or ranking only need the results above. For games, set up the matches.</p>
                  <input type="hidden" name="intent" value="create-competition" />
                  <fieldset>
                    <legend>Elims</legend>
                    <p class="hint">Every tribu plays every other tribu. The table decides the medals, or who goes on to the playoffs.</p>
                    <label class="check"><input type="radio" name="elims" value="0" checked={setup.elims === '0'} /> No elims</label>
                    <label class="check"><input type="radio" name="elims" value="1" checked={setup.elims === '1'} /> Everyone plays everyone once (round robin)</label>
                    <label class="check"><input type="radio" name="elims" value="2" checked={setup.elims === '2'} /> Everyone plays everyone twice (double round robin)</label>
                  </fieldset>
                  <fieldset>
                    <legend>Playoffs</legend>
                    <label class="check"><input type="radio" name="playoffs" value="none" checked={setup.playoffs === 'none'} /> No playoffs: the elims table decides the medals</label>
                    <label class="check"><input type="radio" name="playoffs" value="knockout" checked={setup.playoffs === 'knockout'} /> Knockout: lose once and you’re out</label>
                    <label class="check"><input type="radio" name="playoffs" value="double" checked={setup.playoffs === 'double'} /> Double elimination: out after two losses (4, 8 or 16 tribus)</label>
                  </fieldset>
                  <div class="row two">
                    <Field name="advance" label="Tribus in the playoffs" type="select" options={sizes} value={setup.advance} hint="Only with elims. The best go on, and 1 plays 4, 2 plays 3." />
                    <Field name="bronze" label="Bronze" type="select" options={[{ value: 'match', label: 'A third-place match' }, { value: 'shared', label: 'Both semifinal losers' }]} value={setup.bronze} hint="With only a final after elims, bronze goes to third in the elims." />
                  </div>
                  <fieldset>
                    <legend>Seeds</legend>
                    <p class="hint">Seed 1 is the strongest. Top seeds meet as late as possible. Choose “Not playing” to leave a tribu out. You can still swap tribus in the draw afterwards.</p>
                    <div class="seeds">
                      {teams.map((t, i) => (
                        <label class="seed">
                          <span>Seed {i + 1}</span>
                          <select name={`seed_${i + 1}`}>
                            <option value="">Not playing</option>
                            {teams.map((o) => <option value={o.id} selected={o.id === t.id}>{o.name}</option>)}
                          </select>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                  <fieldset>
                    <legend>Elims points</legend>
                    <div class="row three">
                      <Field name="win" label="Win" type="number" min={0} max={10} step="0.5" value="3" />
                      <Field name="draw" label="Draw" type="number" min={0} max={10} step="0.5" value="1" />
                      <Field name="loss" label="Loss" type="number" min={0} max={10} step="0.5" value="0" />
                    </div>
                  </fieldset>
                  <div class="form-actions"><button class="btn btn-primary" type="submit">Set up the matches</button></div>
                </form>
              ) : (
                <>
                  {draw.length > 0 && (
                    <form method="post" id="draw-form" data-draw hidden>
                      <input type="hidden" name="intent" value="swap" />
                      <input type="hidden" name="from" value="" />
                      <input type="hidden" name="to" value="" />
                    </form>
                  )}
                  {elims.map((sv) => (
                    <section class="stage" id={`stage-${sv.stage.id}`} aria-labelledby={`stage-title-${sv.stage.id}`}>
                      <div class="stage-head">
                        <h3 id={`stage-title-${sv.stage.id}`}>{sv.stage.name}</h3>
                        <form class="rule" method="post">
                          <input type="hidden" name="intent" value="points" />
                          <input type="hidden" name="stageId" value={sv.stage.id} />
                          <label class="small">Win <input type="number" name="win" min="0" max="10" step="0.5" value={sv.stage.pointsWin} /></label>
                          <label class="small">Draw <input type="number" name="draw" min="0" max="10" step="0.5" value={sv.stage.pointsDraw} /></label>
                          <label class="small">Loss <input type="number" name="loss" min="0" max="10" step="0.5" value={sv.stage.pointsLoss} /></label>
                          <button class="btn btn-secondary btn-small" type="submit">Save points</button>
                        </form>
                      </div>
                      {table && (
                        <div class="table-wrap">
                          <table class="table standings">
                            <thead><tr><th scope="col"><span class="visually-hidden">Rank</span></th><th scope="col">Tribu</th><th scope="col" class="num">P</th><th scope="col" class="num">W</th><th scope="col" class="num">D</th><th scope="col" class="num">L</th><th scope="col" class="num">Pts</th></tr></thead>
                            <tbody>
                              {table.rows.map((r) => {
                                const t = byId.get(r.tribuId);
                                return (
                                  <tr>
                                    <td class="num">{r.rank}</td>
                                    <th scope="row"><span class="tribu">{t && <TribuMark tribu={t} size="xs" />}{t?.name}</span></th>
                                    <td class="num">{r.played}</td>
                                    <td class="num">{r.won}</td>
                                    <td class="num">{r.drawn}</td>
                                    <td class="num">{r.lost}</td>
                                    <td class="num strong">{formatScore(r.points)}</td>
                                  </tr>
                                );
                              })}
                            </tbody>
                          </table>
                          <p class="hint">{pointsRuleText({ win: sv.stage.pointsWin, draw: sv.stage.pointsDraw, loss: sv.stage.pointsLoss })}. Ties are split by the matches between the tied tribus, then score difference.</p>
                        </div>
                      )}
                      {sv.rounds.map((r) => (
                        <form class="round" method="post" id={`round-${sv.stage.id}-${r.round}`}>
                          <input type="hidden" name="intent" value="save-matches" />
                          <div class="round-head">
                            <h4>{r.title}</h4>
                            <button class="btn btn-primary btn-small" type="submit">Save round</button>
                          </div>
                          <div class="round-matches">
                            {r.matches.map((m) => (
                              <AdminMatch match={m} teams={teams} byId={byId} deletable />
                            ))}
                          </div>
                          <button class="text-danger" type="submit" name="deleteRound" value={`${sv.stage.id}:${r.round}`} formnovalidate data-confirm={`Delete ${r.title.toLowerCase()} and its ${r.matches.length} ${r.matches.length === 1 ? 'match' : 'matches'}? Their scores go too.`}>
                            Delete {r.title.toLowerCase()}
                          </button>
                        </form>
                      ))}
                      <details class="add-match">
                        <summary>Add a match</summary>
                        <form class="add-match-form" method="post">
                          <input type="hidden" name="intent" value="add-match" />
                          <input type="hidden" name="stageId" value={sv.stage.id} />
                          <label>
                            <span>Round</span>
                            <input type="number" name="round" min="1" max="99" value={lastRound(sv)} />
                          </label>
                          <label>
                            <span>First tribu</span>
                            <select name="home">
                              {teams.map((t) => <option value={t.id}>{t.name}</option>)}
                            </select>
                          </label>
                          <label>
                            <span>Second tribu</span>
                            <select name="away">
                              {teams.map((t, i) => <option value={t.id} selected={i === 1}>{t.name}</option>)}
                            </select>
                          </label>
                          <button class="btn btn-secondary btn-small" type="submit">Add match</button>
                        </form>
                      </details>
                    </section>
                  ))}
                  {knockout.length > 0 && (
                    <section class="stage" id={`stage-${knockout[0].stage.id}`} aria-labelledby="bracket-title">
                      <div class="stage-head">
                        <h3 id="bracket-title">{hasElims ? 'Playoffs' : 'Bracket'}</h3>
                        {hasElims && !drawLocked && (
                          <form method="post">
                            <input type="hidden" name="intent" value="send-to-playoffs" />
                            <button class="btn btn-secondary btn-small" type="submit" data-confirm={draw.some((m) => m.homeTribuId !== null || m.awayTribuId !== null) ? 'Replace the playoff tribus with the top of the elims table?' : undefined}>
                              Send the top {draw.length * 2} on
                            </button>
                          </form>
                        )}
                      </div>
                      <p class="hint" data-draw-status="draw-form" aria-live="polite">
                        {drawLocked
                          ? 'A match has a result, so the draw is fixed. To change tribus, use Edit on a match without a result.'
                          : 'To change the draw, tap a tribu in the first round, then the one it should trade places with. On a computer you can also drag one onto the other.'}
                      </p>
                      <form method="post">
                        <input type="hidden" name="intent" value="save-matches" />
                        {knockout.map((sv) => (
                          <div class="kstage" id={`stage-${sv.stage.id}`}>
                            {(sv.stage.kind === 'upper' || sv.stage.kind === 'lower') && <p class="kstage-name">{sv.stage.name}</p>}
                            <div class="kbracket">
                              {sv.rounds.map((r) => (
                                <div class="kcol">
                                  <h4>{r.title}</h4>
                                  <div class="kmatches">
                                    {r.matches.map((m) => (
                                      <AdminMatch match={m} teams={teams} byId={byId} layout="card" drawForm={!drawLocked && drawIds.has(m.id) ? 'draw-form' : null} />
                                    ))}
                                  </div>
                                </div>
                              ))}
                            </div>
                          </div>
                        ))}
                        <div class="form-actions"><button class="btn btn-primary" type="submit">Save scores</button></div>
                      </form>
                    </section>
                  )}
                  <form method="post">
                    <input type="hidden" name="intent" value="delete-competition" />
                    <button class="btn btn-danger" type="submit" data-confirm="Remove every match of this category, with their scores? Results above stay.">Remove the matches</button>
                  </form>
                </>
              )}
            </section>
          </>
        )
      }
    </div>

    <div>
      <form class="panel form" method="post">
        <h2>Event</h2>
        <input type="hidden" name="intent" value="event" />
        <Field name="name" id="event-name" label="Event" value={ev('name')} error={errors.name} maxlength={80} />
        <Field name="type" label="How it’s decided" type="select" options={TYPES} value={ev('type')} error={errors.type} />
        <Field name="status" label="Status" type="select" options={STATUSES} value={ev('status')} error={errors.status} hint="A category with a gold medal shows as final on its own." />
        <Field name="startsAt" label="Starts (optional)" type="datetime-local" value={ev('startsAt')} error={errors.startsAt} hint="Philippine time." />
        <Field name="venue" label="Venue (optional)" value={ev('venue')} error={errors.venue} />
        <Field name="note" label="Note (optional)" value={ev('note')} error={errors.note} />
        <div class="form-actions"><button class="btn btn-primary" type="submit">Save event</button></div>
      </form>

      <section class="panel">
        <h2>Categories</h2>
        {category && (
          <form class="form" method="post">
            <input type="hidden" name="intent" value="rename-category" />
            <Field name="name" id="cat-name" label={`Rename ${categoryLabel(category)}`} value={category.name} />
            <div class="row two">
              <Field name="groupName" id="cat-group" label="Group (optional)" value={category.groupName ?? ''} hint="Puts categories under one heading, like Men’s." />
              <Field name="sort" id="cat-sort" label="Order" type="number" min={0} max={99} value={category.sort} />
            </div>
            <div class="form-actions">
              <button class="btn btn-secondary" type="submit">Save category</button>
              {event.categories.length > 1 && (
                <button class="btn btn-danger" type="submit" name="intent" value="delete-category" data-confirm={`Remove ${categoryLabel(category)} with its results and matches?`}>
                  Remove
                </button>
              )}
            </div>
          </form>
        )}
        <form class="form add-cat" method="post">
          <input type="hidden" name="intent" value="add-category" />
          <Field name="name" id="new-cat" label="Add a category" placeholder="Women’s, or 50m freestyle" />
          <div class="row two">
            <Field name="groupName" id="new-group" label="Group (optional)" placeholder="Men’s" value={category?.groupName ?? ''} />
            <Field name="sort" id="new-sort" label="Order" type="number" min={0} max={99} value={event.categories.length} />
          </div>
          <div class="form-actions"><button class="btn btn-secondary" type="submit">Add category</button></div>
        </form>
      </section>

    </div>
  </div>
</Admin>

<style>
  .tabs {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }
  .tab-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .tab-heading {
    min-width: 72px;
    font-size: 13px;
    font-weight: 600;
    color: var(--grey-600);
  }
  .tribu {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .place {
    width: 160px;
  }
  .count {
    width: 96px;
  }
  .count input {
    width: 80px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* Looks like the yellow switch elsewhere in the admin, but is a button so it can confirm. */
  .switch-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
  }
  .switch-button .track {
    position: relative;
    flex: none;
    width: 44px;
    height: 24px;
    border: 1px solid var(--grey-300);
    background: var(--grey-300);
  }
  .switch-button .track::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    background: var(--white);
  }
  .switch-button[aria-checked="true"] .track {
    border-color: var(--ink);
    background: var(--sunrise);
  }
  .switch-button[aria-checked="true"] .track::after {
    left: 22px;
    background: var(--ink);
  }
  .switch-button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .seeds {
    display: grid;
    gap: 8px;
  }
  .seed {
    display: grid;
    grid-template-columns: 70px 1fr;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  /* Let wide content, like a bracket, scroll inside its column instead of widening the page. */
  .columns > div,
  .panel {
    min-width: 0;
  }
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    margin-bottom: 32px;
    scroll-margin-top: 16px;
  }
  .stage-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .stage-head h3 {
    margin: 0;
    font-size: 18px;
  }
  .stage .hint {
    margin: 0;
  }
  .rule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .rule input {
    width: 64px;
    min-height: 32px;
    padding: 4px 8px;
  }
  .standings {
    font-size: 14px;
  }
  .standings .num {
    width: 44px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .standings .strong {
    font-weight: 700;
  }
  .round {
    display: grid;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--grey-300);
    scroll-margin-top: 16px;
  }
  .round-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .round-head h4,
  .kcol h4 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }
  .round-matches {
    display: grid;
    gap: 6px;
  }
  .text-danger {
    justify-self: start;
    padding: 4px 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13px;
    color: var(--red);
    text-decoration: underline;
    cursor: pointer;
  }
  .add-match summary {
    width: max-content;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .add-match-form {
    display: grid;
    gap: 8px;
    margin-top: 8px;
  }
  .add-match-form label {
    display: grid;
    gap: 4px;
