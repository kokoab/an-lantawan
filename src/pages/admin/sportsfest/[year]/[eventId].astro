  }
  .add-match-form .btn {
    justify-self: start;
  }
  /* A bracket: one column per round, each round's matches spread to sit level with the
     matches that feed them. Scrolls sideways on phones. */
  .kstage + .kstage {
    margin-top: 16px;
  }
  .kstage-name {
    margin: 0 0 8px;
    font-size: 13px;
