---
import PinIcon from '../../../assets/icons/admin/pin.svg';
import PlusIcon from '../../../assets/icons/admin/plus.svg';
import { parsePage } from '../../../core/paging';
import { formatWhen } from '../../../core/when';
import { db } from '../../../db/client';
import { listAdminStories, type StoryStatus } from '../../../db/queries/admin/stories';
import { getSettings } from '../../../db/queries/settings';
import Admin from '../../../layouts/Admin.astro';
import { mediaUrl } from '../../../lib/urls';

const params = Astro.url.searchParams;
const FILTERS: Array<{ value: StoryStatus | null; label: string }> = [
  { value: null, label: 'All' },
  { value: 'draft', label: 'Drafts' },
  { value: 'scheduled', label: 'Scheduled' },
  { value: 'published', label: 'Published' },
];
const asked = params.get('status');
const status =
  asked === 'archived' ? 'archived' : (FILTERS.find((f) => f.value === asked)?.value ?? null);
const q = (params.get('q') ?? '').trim().slice(0, 100);
const page = parsePage(params.get('page')) ?? 1;
const now = new Date();

const [list, pin] = await Promise.all([
  listAdminStories(db, { status, sectionId: null, kind: null, q, page, perPage: 20 }),
  getSettings(db, { 'home.pinned_story_id': null as number | null }),
]);
const pinnedId = pin['home.pinned_story_id'];
const STATUS = {
  draft: { label: 'Draft', tone: '' },
  scheduled: { label: 'Scheduled', tone: 'grey' },
  published: { label: 'Published', tone: 'ink' },
  archived: { label: 'Archived', tone: 'grey' },
} as const;
const href = (change: { status?: string | null; page?: number }) => {
  const u = new URLSearchParams();
  const s = 'status' in change ? change.status : status;
  if (s) u.set('status', s);
  if (q) u.set('q', q);
  if (change.page && change.page > 1) u.set('page', String(change.page));
  return `/admin/stories${u.size ? `?${u}` : ''}`;
};
---

<Admin title="Stories" section="stories" subtitle={`${list.total} ${list.total === 1 ? 'story' : 'stories'}`}>
  <a slot="actions" class="btn btn-sunrise" href="/admin/stories/new"><PlusIcon /> New story</a>

  <div class="bar">
    <nav class="segments" aria-label="Show">
      {FILTERS.map((f) => (
        <a class:list={['btn', f.value === status ? 'btn-primary' : 'btn-secondary']} href={href({ status: f.value })} aria-current={f.value === status ? 'page' : undefined}>
          {f.label}
        </a>
      ))}
    </nav>
    <form method="get" role="search" class="search">
      {status && <input type="hidden" name="status" value={status} />}
      <label class="visually-hidden" for="story-search">Search stories</label>
      <input id="story-search" type="search" name="q" value={q} placeholder="Search stories" />
    </form>
  </div>

  {
    list.rows.length === 0 ? (
      <div class="empty-state">
        <h2>{q ? `No stories match “${q}”` : status ? `No ${FILTERS.find((f) => f.value === status)?.label.toLowerCase() ?? 'stories'}` : 'No stories yet'}</h2>
        <p>{q || status ? 'Try other words, or show all stories.' : 'Write the first one.'}</p>
        <a class="btn btn-secondary" href={q || status ? '/admin/stories' : '/admin/stories/new'}>{q || status ? 'Show all stories' : 'New story'}</a>
      </div>
    ) : (
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Story</th>
              <th scope="col">Status</th>
              <th scope="col" class="hide-sm">Author</th>
              <th scope="col" class="hide-sm">Updated</th>
              <th scope="col"><span class="visually-hidden">Edit</span></th>
            </tr>
          </thead>
          <tbody>
            {list.rows.map((s) => (
              <tr>
                <td>
                  <span class="story-cell">
                    {s.coverKey ? <img class="thumb" src={mediaUrl(s.coverKey)} alt="" loading="lazy" /> : <span class="thumb" />}
                    <span class="text">
                      <strong>
                        {s.id === pinnedId && (
                          <span class="pin" title="Pinned as the top story">
                            <PinIcon />
                            <span class="visually-hidden">Pinned: </span>
                          </span>
                        )}
                        {s.title || 'Untitled draft'}
                      </strong>
                      <span>{s.section}</span>
                    </span>
                  </span>
                </td>
                <td>
                  <span class:list={['tag', STATUS[s.status].tone]}>{STATUS[s.status].label}</span>
                </td>
                <td class="hide-sm">{s.author ?? ''}</td>
                <td class="hide-sm nowrap">{formatWhen(s.status === 'scheduled' ? s.publishedAt : s.updatedAt, now, { olderAsDate: true })}</td>
                <td class="actions">
                  <a href={`/admin/stories/${s.id}`}>Edit<span class="visually-hidden"> {s.title}</span></a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    list.pages > 1 && (
      <nav class="pager" aria-label="Pages">
        <a class="btn btn-secondary" href={page > 1 ? href({ page: page - 1 }) : undefined} aria-disabled={page <= 1 ? 'true' : undefined}>Previous</a>
        <span>Page {page} of {list.pages}</span>
        <a class="btn btn-secondary" href={page < list.pages ? href({ page: page + 1 }) : undefined} aria-disabled={page >= list.pages ? 'true' : undefined}>Next</a>
      </nav>
    )
  }
</Admin>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
  .search {
    flex: 1 1 240px;
    max-width: 320px;
  }
  .pin {
    display: inline-block;
    margin-right: 4px;
    vertical-align: -2px;
  }
  .pin :global(svg) {
    width: 14px;
    height: 14px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .story-cell strong {
    font-size: 15px;
  }
</style>
