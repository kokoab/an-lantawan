---
import StoryEditor from '../../../../components/admin/editor/StoryEditor.svelte';
import { db } from '../../../../db/client';
import Admin from '../../../../layouts/Admin.astro';
import { editorOf, idParam } from '../../../../lib/admin';
import { storyEditorProps } from '../../../../lib/story-editor-props';

const editor = editorOf(Astro);
const id = idParam(Astro.params.id);
const props = id ? await storyEditorProps(db, id) : null;
if (!props) return Astro.rewrite('/404');
const host = new URL(Astro.site ?? Astro.url).host;
---

<Admin title={props.story.title || 'Edit story'} section="stories" bare>
  <StoryEditor client:only="svelte" {...props} host={host} me={editor.person?.name ?? null} />
  <noscript><p class="admin-error-summary">The story editor needs JavaScript. Turn it on, then reload.</p></noscript>
</Admin>
