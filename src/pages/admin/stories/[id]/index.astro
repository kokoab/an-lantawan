---
import StoryForm from '../../../../components/admin/StoryForm.astro';
import { isLive, nextState } from '../../../../core/stories';
import { db } from '../../../../db/client';
import {
  getStoryForEdit,
  getVersion,
  listVersions,
  restoreVersion,
  setStoryState,
} from '../../../../db/queries/admin/stories';
import { getSettings } from '../../../../db/queries/settings';
import Admin from '../../../../layouts/Admin.astro';
import { doneRedirect, editorOf, idParam, one, readForm, record } from '../../../../lib/admin';
import { formatStamp } from '../../../../lib/format';
import {
  coverFromForm,
  creditsFromForm,
  formList,
  storyFormChoices,
} from '../../../../lib/story-form-data';
import { saveStoryForm } from '../../../../lib/story-save';

const editor = editorOf(Astro);
const id = idParam(Astro.params.id);
const story = id ? await getStoryForEdit(db, id) : null;
if (!story) return Astro.rewrite('/404');
const here = `/admin/stories/${story.id}`;

const { 'home.pinned_story_id': pinnedId } = await getSettings(db, {
  'home.pinned_story_id': null as number | null,
});
let values: Record<string, unknown> = {
  ...story,
  tags: story.tags.join(', '),
  pinned: pinnedId === story.id,
};
let errors: Record<string, string> = {};
let body = JSON.stringify(story.body);
let credits: Array<{ personId: number | string; role: string }> = story.credits;
let eventIds = story.eventIds;
let cover = story.cover;

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const intent = one(form, 'intent');
  if (intent === 'archive' || intent === 'restore') {
    const next = nextState(story, intent, null, new Date());
    await setStoryState(db, story.id, next.status, next.publishedAt);
    await record(editor, {
      action: intent,
      entityType: 'story',
      entityId: story.id,
      summary: `${intent === 'archive' ? 'Archived' : 'Restored'} “${story.title}”`,
    });
    return doneRedirect(Astro, here, intent === 'archive' ? 'archived' : 'restored');
  }
  if (intent === 'restore-version') {
    const version = await getVersion(db, story.id, Number(one(form, 'versionId')));
    if (version) {
      await restoreVersion(db, story.id, version, editor.id);
      await record(editor, {
        action: 'update',
        entityType: 'story',
        entityId: story.id,
        summary: `Restored an earlier version of “${version.title}”`,
      });
      return doneRedirect(Astro, here, 'restored');
    }
    return doneRedirect(Astro, here, 'saved');
  }
  const saved = await saveStoryForm(db, form, editor, story);
  if (saved.ok) return doneRedirect(Astro, here, saved.done);
  values = form;
  errors = saved.errors;
  body = one(form, 'body') || body;
  credits = creditsFromForm(form);
  eventIds = formList(form, 'eventIds').map(Number);
  cover = await coverFromForm(db, form);
  Astro.response.status = 422;
}

const [choices, versions] = await Promise.all([storyFormChoices(db), listVersions(db, story.id)]);
const live = isLive(story, new Date());
---

<Admin title={story.title} section="stories" back={{ label: 'Stories', href: '/admin/stories' }}>
  <Fragment slot="actions">
    <a class="btn btn-secondary" href={`${here}/preview`} target="_blank" rel="noopener">Preview</a>
    {live && <a class="btn btn-secondary" href={`/${story.sectionSlug}/${story.slug}`} target="_blank" rel="noopener">View on site</a>}
  </Fragment>

  <StoryForm
    values={values}
    errors={errors}
    status={story.status}
    sections={choices.sections}
    people={choices.people}
    events={choices.events}
    credits={credits}
    eventIds={eventIds}
    cover={cover}
    body={body}
    isNew={false}
  />

  <div class="columns two-up">
    <section class="panel">
      <h2>Earlier versions</h2>
      <p class="panel-note">Every save keeps a copy of the headline, summary and text.</p>
      {
        versions.length <= 1 ? (
          <p class="muted small">No earlier versions yet.</p>
        ) : (
          <ul class="versions">
            {versions.slice(1).map((ver) => (
              <li>
                <span>
                  <strong class="small">{ver.title}</strong>
                  <span class="muted small">{formatStamp(ver.savedAt)}</span>
                </span>
                <form method="post">
                  <input type="hidden" name="intent" value="restore-version" />
                  <input type="hidden" name="versionId" value={ver.id} />
                  <button class="link-button small" type="submit" data-confirm="Put this version’s headline, summary and text back? The current text is kept as a version too.">
                    Restore
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )
      }
    </section>
    <section class="panel">
      <h2>{story.status === 'archived' ? 'Archived' : 'Archive'}</h2>
      <form method="post">
        <p class="panel-note">
          {story.status === 'archived'
            ? 'This story is hidden from the site. Restoring it makes it a draft again.'
            : 'Archiving takes the story off the site for good, but keeps it here. Use Move to drafts for a short break.'}
        </p>
        <input type="hidden" name="intent" value={story.status === 'archived' ? 'restore' : 'archive'} />
        {
          story.status === 'archived' ? (
            <button class="btn btn-secondary" type="submit">Restore as a draft</button>
          ) : (
            <button class="btn btn-danger" type="submit" data-confirm={`Archive “${story.title}”? It disappears from the site.`}>
              Archive story
            </button>
          )
        }
      </form>
    </section>
  </div>
</Admin>

<style>
  .two-up {
    margin-top: 24px;
  }
  .versions {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .versions li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-block: 8px;
    border-bottom: 1px solid var(--grey-300);
  }
  .versions li > span {
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 1024px) {
    .two-up {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
