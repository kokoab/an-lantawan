---
import Field from '../../../components/admin/Field.astro';
import { parseForm, toDateTimeInput } from '../../../core/forms';
import { db } from '../../../db/client';
import {
  closeOpenPrompts,
  createPrompt,
  listPrompts,
  updatePrompt,
} from '../../../db/queries/admin/sumat';
import { currentPrompt } from '../../../db/queries/sumat';
import Admin from '../../../layouts/Admin.astro';
import { doneRedirect, editorOf, one, readForm, record } from '../../../lib/admin';
import { promptForm } from '../../../lib/admin-schemas';
import { formatStamp } from '../../../lib/format';

const editor = editorOf(Astro);
let values: Record<string, unknown> = {};
let errors: Record<string, string> = {};
let editing: number | null = Number(Astro.url.searchParams.get('edit')) || null;

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const intent = one(form, 'intent');
  if (intent === 'close') {
    await closeOpenPrompts(db);
    await record(editor, { action: 'update', entityType: 'sumat', summary: 'Closed Sumat' });
    return doneRedirect(Astro, '/admin/sumat/prompts', 'saved');
  }
  const promptId = Number(one(form, 'promptId')) || null;
  const parsed = parseForm(promptForm, form);
  if (parsed.ok) {
    const opensAt = parsed.data.opensAt ?? new Date();
    if (parsed.data.closesAt && parsed.data.closesAt <= opensAt)
      errors.closesAt = 'Close it after it opens.';
    else {
      const p = { text: parsed.data.text, opensAt, closesAt: parsed.data.closesAt };
      if (promptId) await updatePrompt(db, promptId, p);
      else await createPrompt(db, p);
      await record(editor, {
        action: promptId ? 'update' : 'create',
        entityType: 'sumat',
        summary: `${promptId ? 'Edited' : 'Added'} the Sumat prompt “${p.text}”`,
      });
      return doneRedirect(Astro, '/admin/sumat/prompts', promptId ? 'saved' : 'created');
    }
  } else errors = parsed.errors;
  values = form;
  editing = promptId;
  Astro.response.status = 422;
}

const [prompts, current] = await Promise.all([listPrompts(db), currentPrompt(db)]);
const now = new Date();
const stateOf = (p: (typeof prompts)[number]) =>
  p.id === current?.id
    ? 'Open now'
    : p.opensAt > now
      ? 'Opens later'
      : p.closesAt && p.closesAt <= now
        ? 'Closed'
        : 'Replaced by a newer prompt';
const edited = editing ? prompts.find((p) => p.id === editing) : null;
const v = (k: string, fallback: string) => (values[k] as string | undefined) ?? fallback;
---

<Admin title="Sumat prompts" section="prompts" back={{ label: 'Sumat inbox', href: '/admin/sumat' }}>
  <a slot="actions" class="btn btn-secondary" href="/sumat" target="_blank" rel="noopener">View Sumat</a>
  <div class="columns main-side">
    <div>
      <section class="panel">
        <h2>{current ? 'Sumat is open' : 'Sumat is closed'}</h2>
        <p class="panel-note">
          {current ? `Students are answering “${current.text}”. The newest open prompt is the one on /sumat.` : 'No prompt is open, so /sumat says it isn’t taking messages. Add a prompt to open it.'}
        </p>
        {current && (
          <form method="post">
            <input type="hidden" name="intent" value="close" />
            <button class="btn btn-danger" type="submit" data-confirm="Close Sumat now? Students won’t be able to send messages until a new prompt opens.">Close Sumat now</button>
          </form>
        )}
      </section>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th scope="col">Prompt</th><th scope="col" class="hide-sm">Opens</th><th scope="col" class="hide-sm">Closes</th><th scope="col" class="num">Messages</th><th scope="col"><span class="visually-hidden">Edit</span></th></tr>
          </thead>
          <tbody>
            {prompts.map((p) => (
              <tr>
                <th scope="row">{p.text}<br /><span class:list={['badge', { sun: p.id === current?.id }]}>{stateOf(p)}</span></th>
                <td class="muted small hide-sm">{formatStamp(p.opensAt)}</td>
                <td class="muted small hide-sm">{p.closesAt ? formatStamp(p.closesAt) : 'When replaced'}</td>
                <td class="num">{p.messages}</td>
                <td class="actions"><a class="small" href={`/admin/sumat/prompts?edit=${p.id}`}>Edit</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <form class="panel form" method="post">
      <h2>{edited ? 'Edit prompt' : 'New prompt'}</h2>
      <p class="panel-note">{edited ? 'Messages already sent keep the wording they answered.' : 'Opening a new prompt replaces the current one on /sumat.'}</p>
      {edited && <input type="hidden" name="promptId" value={edited.id} />}
      <Field name="text" label="Question" type="textarea" rows={3} value={v('text', edited?.text ?? '')} error={errors.text} maxlength={300} placeholder="What should the university fix first?" />
      <Field name="opensAt" label="Opens" type="datetime-local" value={v('opensAt', edited ? toDateTimeInput(edited.opensAt) : '')} error={errors.opensAt} hint="Philippine time. Leave empty to open it now." />
      <Field name="closesAt" label="Closes" type="datetime-local" value={v('closesAt', edited ? toDateTimeInput(edited.closesAt) : '')} error={errors.closesAt} hint="Leave empty to keep it open until a newer prompt replaces it." />
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">{edited ? 'Save prompt' : 'Open this prompt'}</button>
        {edited && <a class="btn btn-secondary" href="/admin/sumat/prompts">Cancel</a>}
      </div>
    </form>
  </div>
</Admin>
