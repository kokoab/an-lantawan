---
/** Old links to one message open it in the inbox. */
import { db } from '../../../db/client';
import { getMessage } from '../../../db/queries/admin/sumat';
import { idParam } from '../../../lib/admin';

const id = idParam(Astro.params.id);
const message = id ? await getMessage(db, id) : null;
if (!message) return Astro.rewrite('/404');
return Astro.redirect(`/admin/sumat?show=${message.status}&open=${message.id}`, 303);
---
