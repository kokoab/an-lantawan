---
import Field from '../../../components/admin/Field.astro';
import { parseForm } from '../../../core/forms';
import { defaultSignature, letterSlug } from '../../../core/sumat/letters';
import { db } from '../../../db/client';
import { listAllSections } from '../../../db/queries/admin/sections';
import { storySlugTaken } from '../../../db/queries/admin/stories';
import {
  getMessage,
  type MessageStatus,
  publishLetter,
  setMessageNotes,
  setMessageStatus,
} from '../../../db/queries/admin/sumat';
import Admin from '../../../layouts/Admin.astro';
import { doneRedirect, editorOf, idParam, one, readForm, record } from '../../../lib/admin';
import { letterForm, notesForm } from '../../../lib/admin-schemas';
import { formatStamp } from '../../../lib/format';

const editor = editorOf(Astro);
const id = idParam(Astro.params.id);
const message = id ? await getMessage(db, id) : null;
if (!message) return Astro.rewrite('/404');
const here = `/admin/sumat/${message.id}`;

const sections = (await listAllSections(db)).filter((s) => !s.archivedAt);
const opinion = sections.find((s) => s.slug === 'opinion');
let letterValues: Record<string, unknown> = {
  text: message.body,
  signature: defaultSignature(message.sentAs, message.name, message.courseYear),
  sectionId: opinion?.id ?? '',
};
let letterErrors: Record<string, string> = {};
let notesError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const intent = one(form, 'intent');
  const MOVES: Record<string, MessageStatus> = {
    shortlist: 'shortlisted',
    archive: 'archived',
    unread: 'new',
  };
  if (intent in MOVES) {
    await setMessageStatus(db, message.id, MOVES[intent]);
    await record(editor, {
      action: 'update',
      entityType: 'sumat',
      entityId: message.id,
      summary: `Moved a Sumat message to ${MOVES[intent] === 'new' ? 'New' : MOVES[intent]}`,
    });
    return doneRedirect(Astro, here, intent === 'archive' ? 'archived' : 'saved');
  }
  if (intent === 'notes') {
    const parsed = parseForm(notesForm, form);
    if (parsed.ok) {
      await setMessageNotes(db, message.id, parsed.data.notes);
      return doneRedirect(Astro, here, 'saved');
    }
    notesError = parsed.errors.notes ?? null;
  }
  if (intent === 'publish' && !message.letter) {
    letterValues = form;
    const parsed = parseForm(letterForm, form);
    if (parsed.ok) {
      const slug = letterSlug(message.id);
      if (await storySlugTaken(db, slug, null))
        letterErrors.text = 'A story already uses this letter’s address.';
      else {
        const storyId = await publishLetter(db, message, {
          ...parsed.data,
          slug,
          publishedAt: parsed.data.publishedAt ?? new Date(),
        });
        await record(editor, {
          action: 'publish',
          entityType: 'story',
          entityId: storyId,
          summary: `Published a Sumat letter signed “${parsed.data.signature}”`,
        });
        return doneRedirect(Astro, here, 'published');
      }
    } else letterErrors = parsed.errors;
  }
  Astro.response.status = 422;
}

const STATUS = {
  new: 'New',
  shortlisted: 'Shortlisted',
  published: 'Published',
  archived: 'Archived',
};
---

<Admin title="Sumat message" section="sumat" back={{ label: 'Sumat inbox', href: `/admin/sumat?show=${message.status}` }}>
  <div class="columns main-side">
    <div>
      <section class="panel">
        <p class="muted small prompt">{message.promptText}</p>
        <p class="body">{message.body}</p>
        <dl class="facts small">
          <dt>Sent</dt>
          <dd>{formatStamp(message.receivedAt)}</dd>
          <dt>From</dt>
          <dd>{message.sentAs === 'named' ? [message.name, message.courseYear].filter(Boolean).join(', ') || 'Signed, no name given' : 'Anonymous'}</dd>
          <dt>Status</dt>
          <dd>{STATUS[message.status]}</dd>
        </dl>
      </section>

      {
        message.letter ? (
          <section class="panel">
            <h2>Published as a letter</h2>
            <p class="panel-note">Edit the letter like any story.</p>
            <div class="form-actions">
              <a class="btn btn-primary" href={`/admin/stories/${message.letter.id}`}>Edit the letter</a>
              <a class="btn btn-secondary" href={`/${message.letter.sectionSlug}/${message.letter.slug}`} target="_blank" rel="noopener">View on site</a>
            </div>
          </section>
        ) : (
          <form class="panel form" method="post">
            <h2>Publish as a letter</h2>
            <p class="panel-note">
              {message.sentAs === 'anonymous'
                ? 'Sent anonymously, so it is signed Anonymous. Fix spelling if you need to, but keep the writer’s meaning.'
                : 'Signed by the writer. Fix spelling if you need to, but keep the writer’s meaning.'}
            </p>
            <input type="hidden" name="intent" value="publish" />
            <Field name="text" label="Letter" type="textarea" rows={6} value={letterValues.text as string} error={letterErrors.text} maxlength={3000} />
            <div class="row two">
              <Field name="signature" label="Signature" value={letterValues.signature as string} error={letterErrors.signature} maxlength={120} />
              <Field
                name="sectionId"
                label="Section"
                type="select"
                options={sections.map((s) => ({ value: s.id, label: s.name }))}
                value={String(letterValues.sectionId ?? '')}
                error={letterErrors.sectionId}
              />
            </div>
            <Field name="publishedAt" label="Publish at" type="datetime-local" value={(letterValues.publishedAt as string) ?? ''} error={letterErrors.publishedAt} hint="Leave empty to publish now. A future time schedules it." />
            <div class="form-actions">
              <button class="btn btn-primary" type="submit" data-confirm="Publish this letter on the site?">Publish letter</button>
            </div>
          </form>
        )
      }
    </div>

    <div>
      <section class="panel">
        <h2>Sort</h2>
        <div class="form-actions stack">
          {message.status !== 'shortlisted' && message.status !== 'published' && (
            <form method="post"><input type="hidden" name="intent" value="shortlist" /><button class="btn btn-secondary" type="submit">Shortlist</button></form>
          )}
          {message.status !== 'archived' && (
            <form method="post"><input type="hidden" name="intent" value="archive" /><button class="btn btn-secondary" type="submit">Archive</button></form>
          )}
          {message.status !== 'new' && message.status !== 'published' && (
            <form method="post"><input type="hidden" name="intent" value="unread" /><button class="btn btn-secondary" type="submit">Move back to New</button></form>
          )}
        </div>
      </section>
      <form class="panel form" method="post">
        <h2>Notes</h2>
        <p class="panel-note">Only editors see these. Never copy them into a letter.</p>
        <input type="hidden" name="intent" value="notes" />
        <Field name="notes" label="Notes for the team" type="textarea" rows={4} value={message.notes ?? ''} error={notesError} maxlength={2000} />
        <div class="form-actions"><button class="btn btn-secondary" type="submit">Save notes</button></div>
      </form>
    </div>
  </div>
</Admin>

<style>
  .prompt {
    margin: 0 0 12px;
  }
  .body {
    margin: 0 0 20px;
    font-size: 20px;
    line-height: 30px;
    letter-spacing: -0.01em;
    white-space: pre-line;
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--grey-300);
  }
  .facts dt {
    color: var(--grey-600);
  }
  .facts dd {
    margin: 0;
  }
  .stack {
    flex-direction: column;
    align-items: stretch;
  }
  .stack form,
  .stack button {
    width: 100%;
  }
</style>
