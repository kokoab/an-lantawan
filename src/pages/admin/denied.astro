---
import SignOutIcon from '../../assets/icons/admin/sign-out.svg';
import AdminAuth from '../../layouts/AdminAuth.astro';
---

<AdminAuth title="No access">
  <h1>This account can’t open the admin</h1>
  <p>You’re signed in with a personal Google account. Sign out, then sign in with the publication’s account.</p>
  <form method="post" action="/auth/signout">
    <button class="btn btn-primary" type="submit"><SignOutIcon /> Sign out</button>
  </form>
  <a class="text-link" href="/">Go to the site</a>
</AdminAuth>
