---
import HomeHero from '../components/home/HomeHero.astro';
import HomeMoreNews from '../components/home/HomeMoreNews.astro';
import HomeOpinion from '../components/home/HomeOpinion.astro';
import HomeSumat from '../components/home/HomeSumat.astro';
import HomeTally from '../components/home/HomeTally.astro';
import { settingDefaults } from '../core/settings';
import { festivalDay, manilaDay } from '../core/sportsfest/display';
import { db } from '../db/client';
import { getHomepage } from '../db/queries/home';
import { getSettings } from '../db/queries/settings';
import { getSportsfest, getTally } from '../db/queries/sportsfest';
import { getSection } from '../db/queries/stories';
import { currentPrompt } from '../db/queries/sumat';
import Site from '../layouts/Site.astro';

const [home, prompt, opinionSection, copy] = await Promise.all([
  getHomepage(db),
  currentPrompt(db),
  getSection(db, 'opinion'),
  getSettings(db, {
    ...settingDefaults('sumat.home_tagline', 'sumat.home_note'),
    'home.sportsfest_banner': true,
  }),
]);
// While a Sportsfest is on, its tally leads the homepage unless editors turned the banner off.
const sf = copy['home.sportsfest_banner'] ? await getSportsfest(db) : null;
const live = sf?.status === 'ongoing' ? sf : null;
const tally = live ? await getTally(db, live) : [];
---

<Site title="An Lantawan">
  {
    live && tally.length > 0 && (
      <HomeTally name={live.name} year={live.year} tally={tally} day={festivalDay(live.startsOn, live.endsOn, manilaDay(new Date()))} />
    )
  }
  {home.lead && <HomeHero lead={home.lead} minutes={home.leadMinutes} excerpt={home.leadExcerpt} latest={home.latest} />}
  {
    prompt && (
      <HomeSumat
        prompt={prompt.text}
        letters={home.letters}
        tagline={copy['sumat.home_tagline']}
        note={copy['sumat.home_note']}
      />
    )
  }
  {home.more.length > 0 && <HomeMoreNews stories={home.more} />}
  {home.opinion.length > 0 && <HomeOpinion intro={opinionSection?.description ?? null} pieces={home.opinion} />}
  {
    !home.lead && (
      <section class="band framed empty">
        <h1>No stories yet</h1>
        <p>Stories will show up here as soon as they're published.</p>
      </section>
    )
  }
</Site>

<style>
  .empty {
    padding-block: 96px;
  }
  .empty h1 {
    margin: 0 0 12px;
    font-size: 48px;
    letter-spacing: -0.04em;
  }
  .empty p {
    margin: 0;
    color: var(--grey-600);
  }
</style>
