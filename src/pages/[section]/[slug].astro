---
import { and, eq, inArray, ne } from 'drizzle-orm';
import ArticleSidebar from '../../components/article/ArticleSidebar.astro';
import Credits from '../../components/article/Credits.astro';
import ReadNext from '../../components/article/ReadNext.astro';
import ShareButtons from '../../components/article/ShareButtons.astro';
import Blocks from '../../components/content/Blocks.astro';
import StoryPhoto from '../../components/stories/StoryPhoto.astro';
import { readingMinutes } from '../../core/content/reading';
import { db } from '../../db/client';
import { findRedirect } from '../../db/queries/redirects';
import { getSection, listNewest } from '../../db/queries/stories';
import { getStoryPage } from '../../db/queries/story-page';
import { currentPrompt } from '../../db/queries/sumat';
import { stories } from '../../db/schema';
import Site from '../../layouts/Site.astro';
import { mediaUrl, storyLabel } from '../../lib/urls';

const story = await getStoryPage(db, Astro.params.slug ?? '');
if (!story) {
  // A renamed story, or a story in a renamed section, answers at its new address.
  const sectionMoved = await findRedirect(db, `/${Astro.params.section}`);
  const moved =
    (await findRedirect(db, Astro.url.pathname)) ??
    (sectionMoved ? `${sectionMoved}/${Astro.params.slug}` : null);
  if (moved) return Astro.redirect(moved, 301);
  return Astro.rewrite('/404');
}
// One address per story: an old or mistyped section sends you to the right one.
if (story.section.slug !== Astro.params.section) {
  return Astro.redirect(`/${story.section.slug}/${story.slug}`, 301);
}

const section = await getSection(db, story.section.slug);
const parentSlug = section?.parentId
  ? (
      await db.query.sections.findFirst({
        where: (s, { eq: e }) => e(s.id, section.parentId as number),
      })
    )?.slug
  : story.section.slug;
const sameSection = inArray(stories.sectionId, [
  story.section.id,
  ...(section?.children.map((c) => c.id) ?? []),
]);
const [latest, next, prompt] = await Promise.all([
  listNewest(db, { exclude: [story.id], limit: 4 }),
  listNewest(db, { where: and(sameSection, ne(stories.id, story.id)), limit: 3 }),
  currentPrompt(db),
]);

const isOpinion = story.section.slug === 'opinion' || parentSlug === 'opinion';
const opinionHead = isOpinion && !(story.cartoonOnTop && story.cover);
const minutes = readingMinutes(story.body);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const label = isOpinion && story.kind === 'opinion' ? 'Opinion' : storyLabel(story);
const coverCaption = [story.cover?.caption, story.cover?.creditText].filter(Boolean).join(' ');
const description = story.dek ?? undefined;
const image = story.cover ? mediaUrl(story.cover.key) : undefined;
---

<Site title={story.title} description={description} image={image} current={parentSlug}>
  <article>
    {
      opinionHead ? (
        <header class="band on-ink opinion-head">
          <span class="pill">{label}</span>
          <h1>{story.title}</h1>
          {story.dek && <p class="dek">{story.dek}</p>}
          <Credits
            credits={story.credits}
            publishedAt={story.publishedAt}
            minutes={minutes}
            dark
            opinion
            writerPhoto={story.writerPhoto}
          />
          <ShareButtons url={url} dark />
          <p class="note">Opinion pieces are the writer’s view. They are kept separate from our news reporting.</p>
        </header>
      ) : (
        story.cover && (
          <figure class="lead-photo">
            <StoryPhoto cover={story.cover} class="lead-photo-img" eager />
            {coverCaption && <figcaption>{coverCaption}</figcaption>}
          </figure>
        )
      )
    }

    <div class="band framed body">
      <div class="column">
        {
          !opinionHead && (
            <header class="title">
              <span class="pill">{label}</span>
              <h1>{story.title}</h1>
              {story.dek && <p class="dek">{story.dek}</p>}
              <Credits credits={story.credits} publishedAt={story.publishedAt} minutes={minutes} opinion={isOpinion} />
              <ShareButtons url={url} />
            </header>
          )
        }
        <div class="prose">
          <Blocks blocks={story.body.content} />
        </div>
        {
          story.tags.length > 0 && (
            <p class="tags">
              {story.tags.map((t) => (
                <span>{t.name}</span>
              ))}
            </p>
          )
        }
      </div>
      <ArticleSidebar latest={latest} prompt={prompt?.text ?? null} />
    </div>
  </article>

  <ReadNext
    title={isOpinion ? 'More opinion' : 'Read next'}
    stories={next}
    allHref={`/${parentSlug}`}
    allLabel={`All ${(isOpinion ? 'opinion' : (section?.name ?? 'stories')).toLowerCase()}`}
  />
</Site>

<style>
  .lead-photo {
    margin: 0;
  }
  .lead-photo :global(.lead-photo-img) {
    aspect-ratio: 390 / 312;
    border: 0;
  }
  .lead-photo figcaption {
    padding: 12px var(--gutter) 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--grey-600);
  }

  .opinion-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-block: 48px 64px;
  }
  .opinion-head h1 {
    margin: 0;
    max-width: 980px;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.05em;
    text-wrap: pretty;
  }
  .opinion-head .dek {
    max-width: 760px;
    color: var(--grey-300);
  }
  .opinion-head :global(.credits) {
    align-self: stretch;
    max-width: 980px;
  }
  .note {
    max-width: 760px;
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--grey-300);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: 32px 96px;
  }
  .column {
    min-width: 0;
  }
  .title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 40px;
  }
  .title h1 {
    margin: 0;
    max-width: 680px;
    font-size: 38px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }
  .dek {
    margin: 0;
    font-size: 18px;
    line-height: 27px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
  }
  .title :global(.credits) {
    align-self: stretch;
  }

  /* Story text */
  .prose {
    max-width: 720px;
    font-size: 18px;
    line-height: 30px;
    letter-spacing: -0.005em;
  }
  .prose :global(p) {
    margin: 0 0 24px;
  }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin: 40px 0 16px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .prose :global(h2) {
    font-size: 28px;
    line-height: 34px;
  }
  .prose :global(h3) {
    font-size: 24px;
    line-height: 30px;
  }
  .prose :global(h4) {
    font-size: 20px;
    line-height: 26px;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 24px;
    padding-left: 24px;
  }
  .prose :global(li > p) {
    margin-bottom: 8px;
  }
  .prose :global(blockquote) {
    margin: 32px 0;
    padding: 28px 0;
    border-top: 3px solid var(--ink);
    font-size: 26px;
    font-weight: 600;
    line-height: 34px;
    letter-spacing: -0.03em;
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(figure) {
    margin: 32px 0;
  }
  .prose :global(figure img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--grey-300);
    background: var(--grey-100);
  }
  .prose :global(figcaption) {
    margin-top: 10px;
    font-size: 14px;
    line-height: 20px;
    color: var(--grey-600);
  }
  .prose :global(.embed) {
    position: relative;
    margin: 32px 0;
    aspect-ratio: 16 / 9;
    background: var(--grey-100);
  }
  .prose :global(.embed iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .prose :global(hr) {
    margin: 40px 0;
    border: 0;
    border-top: 1px solid var(--grey-300);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
  }
  .tags span {
    padding: 6px 12px;
    border: 1px solid var(--grey-300);
    font-size: 14px;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .lead-photo :global(.lead-photo-img) {
      aspect-ratio: 1440 / 640;
    }
  }

  @media (min-width: 1024px) {
    .opinion-head {
      gap: 28px;
      padding-block: 96px 129px;
    }
    .opinion-head h1 {
      font-size: 72px;
      line-height: 74px;
    }
    .opinion-head .dek {
      font-size: 22px;
      line-height: 32px;
    }
    .body {
      flex-direction: row;
      align-items: flex-start;
      padding-block: 64px 180px;
    }
    .column {
      flex: 0 0 calc((100% - 48px) * 768 / 1168);
    }
    .body > :global(.sidebar) {
      flex: 1;
    }
    .title {
      gap: 24px;
      margin-bottom: 48px;
    }
    .title h1 {
      font-size: 60px;
      line-height: 62px;
    }
    .dek {
      font-size: 22px;
      line-height: 32px;
    }
    .prose {
      font-size: 20px;
      line-height: 32px;
    }
    .prose :global(h2) {
      font-size: 32px;
      line-height: 38px;
    }
    .prose :global(blockquote) {
      font-size: 32px;
      line-height: 40px;
    }
  }
</style>
