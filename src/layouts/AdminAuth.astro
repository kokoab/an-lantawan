---
/** The centred card of the sign-in screens: Sign in, No access and Who’s editing. */
import AdminBrand from '../components/admin/AdminBrand.astro';
import '../styles/site.css';
import '../styles/admin.css';

interface Props {
  title: string;
  /** 640px for Who’s editing; 460px otherwise. */
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · An Lantawan admin</title>
  </head>
  <body class="admin auth">
    <main class:list={['auth-card', { wide }]}>
      <AdminBrand />
      <slot />
    </main>
  </body>
</html>

<style>
  .auth {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 16px;
  }
  .auth-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    max-width: 460px;
    padding: 32px 24px;
    border: 1px solid var(--grey-300);
    background: var(--white);
  }
  .auth-card.wide {
    max-width: 640px;
  }
  .auth-card :global(.admin-brand) {
    margin-bottom: 20px;
  }
  .auth-card :global(h1) {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    line-height: 36px;
    letter-spacing: -0.04em;
  }
  .auth-card :global(p) {
    margin: 0;
    font-size: 15px;
    line-height: 24px;
    color: var(--grey-600);
  }
  .auth-card :global(.btn) {
    width: 100%;
    margin-top: 8px;
  }
  .auth-card :global(.text-link) {
    align-self: flex-start;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .auth-card :global(.error) {
    color: var(--red);
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .auth-card {
      padding: 40px 40px 36px;
    }
  }
</style>
