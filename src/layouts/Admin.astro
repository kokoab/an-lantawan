---
/** Every admin page: the sidebar (a menu on phones), the page title with its actions, and notices. */
import { and, count, eq } from 'drizzle-orm';
import CloseIcon from '../assets/icons/admin/close.svg';
import SignOutIcon from '../assets/icons/admin/sign-out.svg';
import AdminBrand from '../components/admin/AdminBrand.astro';
import { db } from '../db/client';
import { events, sportsfests, sumatMessages } from '../db/schema';
import { doneMessage, editorOf } from '../lib/admin';
import '../styles/site.css';
import '../styles/admin.css';

interface Props {
  title: string;
  /** Which menu entry to mark. */
  section:
    | 'overview'
    | 'stories'
    | 'home'
    | 'sumat'
    | 'sportsfest'
    | 'print'
    | 'staff'
    | 'settings';
  /** The line under the title: a date, a count, “Draft, saved at 2:41 PM”. */
  subtitle?: string | null;
  /** A link back up, shown above the title. */
  back?: { label: string; href: string };
  /** The page draws its own header, as the story editor does. */
  bare?: boolean;
}

const { title, section, subtitle, back, bare = false } = Astro.props;
const editor = editorOf(Astro);
const notice = doneMessage(Astro.url);
const [[{ unread }], [{ ongoing }]] = await Promise.all([
  db.select({ unread: count() }).from(sumatMessages).where(eq(sumatMessages.status, 'new')),
  db
    .select({ ongoing: count() })
    .from(events)
    .innerJoin(sportsfests, eq(sportsfests.id, events.sportsfestId))
    .where(and(eq(events.status, 'ongoing'), eq(sportsfests.status, 'ongoing'))),
]);

const MENU = [
  { id: 'overview', label: 'Overview', href: '/admin' },
  { id: 'stories', label: 'Stories', href: '/admin/stories' },
  { id: 'home', label: 'Home', href: '/admin/home' },
  { id: 'sumat', label: 'Sumat', href: '/admin/sumat', badge: unread ? `${unread} new` : null },
  {
    id: 'sportsfest',
    label: 'Sportsfest',
    href: '/admin/sportsfest',
    badge: ongoing ? `${ongoing} ongoing` : null,
  },
  { id: 'print', label: 'Print issues', href: '/admin/print' },
  { id: 'staff', label: 'Staff', href: '/admin/staff' },
  { id: 'settings', label: 'Site settings', href: '/admin/settings' },
];
const who = editor.person?.name ?? editor.name;
const switchHref = `/admin/who?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · An Lantawan admin</title>
  </head>
  <body class="admin">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="admin-shell">
      <header class="admin-bar">
        <AdminBrand href="/admin" />
        <button class="admin-bar-menu" type="button" aria-expanded="false" aria-controls="admin-side" data-admin-menu>
          Menu
        </button>
      </header>

      <aside class="admin-side" id="admin-side" aria-label="Admin">
        <div class="admin-side-head">
          <AdminBrand href="/admin" />
          <button class="admin-side-close" type="button" aria-label="Close the menu" data-admin-menu-close><CloseIcon /></button>
        </div>
        <nav>
          <ul>
            {
              MENU.map((i) => (
                <li>
                  <a href={i.href} aria-current={i.id === section ? 'page' : undefined}>
                    <span>{i.label}</span>
                    {i.badge && <span class="tag sun">{i.badge}</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="admin-account">
          <p class="muted">Editing as</p>
          <p class="who">{who}</p>
          <div class="admin-account-links">
            <a href={switchHref}>Switch person</a>
            <a class="phone-only" href="/" target="_blank" rel="noopener">View the site</a>
          </div>
          <form method="post" action="/auth/signout" class="phone-only">
            <button class="btn btn-secondary" type="submit"><SignOutIcon /> Sign out</button>
          </form>
        </div>
      </aside>

      <main class="admin-main" id="main">
        {!bare && (<header class="admin-head">
          <div class="admin-title">
            {back && <a class="admin-back" href={back.href}>{back.label}</a>}
            <h1>{title}</h1>
            {subtitle && <p>{subtitle}</p>}
          </div>
          {Astro.slots.has('actions') && <div class="admin-actions"><slot name="actions" /></div>}
        </header>)}
        {
          notice && (
            <p class="admin-notice" role="status">
              {notice}
            </p>
          )
        }
        <slot />
      </main>
    </div>
    <slot name="dialogs" />
    <script>
      import '../scripts/admin';
    </script>
  </body>
</html>
