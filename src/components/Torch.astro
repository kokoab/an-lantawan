---
/** The An Lantawan torch mark. Size it with CSS on the parent or via `class`. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const gradientId = `torch-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={className} viewBox="0 0 1015 1630" aria-hidden="true">
  <defs>
    <linearGradient id={gradientId} x1="600" y1="0" x2="300" y2="1400" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFE400"></stop><stop offset="1" stop-color="#FFC700"></stop>
    </linearGradient>
  </defs>
  <path d="M135 600 L880 75 L608 1455 L298 1625 Z" fill="#E6E6E6"></path>
  <g fill={`url(#${gradientId})`} stroke="#fff" stroke-width="18" stroke-linejoin="round">
    <path d="M193 235 L392 62 L408 75 L500 0 L492 345 L373 430 L380 632 L268 695 Z"></path>
    <path d="M497 205 L655 230 L492 345 Z"></path>
    <path
      d="M268 695 L380 632 L373 430 L660 230 L558 745 L640 770 L510 1350 L427 1402 L415 1288 L385 1332 L380 1308 L367 1325 Z"
    ></path>
  </g>
</svg>
