---
/**
 * An issue's cover: the uploaded cover image shown whole, or, when there isn't one,
 * a designed cover with the wordmark, kind, month and title.
 */
import type { Issue } from '../../db/queries/issues';
import { formatMonth } from '../../lib/format';
import { mediaUrl } from '../../lib/urls';

interface Props {
  issue: Pick<Issue, 'kind' | 'title' | 'publishedOn' | 'coverKey'>;
  large?: boolean;
}

const { issue, large = false } = Astro.props;
const kindLabel = issue.kind === 'newsletter' ? 'Newsletter' : 'Special publication';
---

{
  issue.coverKey ? (
    <div class:list={['cover', 'image', large && 'large']}>
      <img src={mediaUrl(issue.coverKey)} alt={`Cover of ${issue.title}`} loading={large ? 'eager' : 'lazy'} />
    </div>
  ) : (
    <div class:list={['cover', 'designed', issue.kind, large && 'large']} aria-hidden="true">
      <span class="wordmark">An Lantawan</span>
      <span class="meta">
        <span>{kindLabel}</span>
        <span>{formatMonth(issue.publishedOn)}</span>
      </span>
      <span class="panel" />
      <span class="title">{issue.title}</span>
    </div>
  )
}

<style>
  .cover {
    aspect-ratio: 400 / 520;
    border: 1px solid var(--grey-300);
    background: var(--grey-100);
    overflow: hidden;
  }
  .image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .designed {
    display: flex;
    flex-direction: column;
    gap: 6%;
    padding: 7%;
    container-type: inline-size;
  }
  .designed.newsletter {
    background: var(--sunrise);
    border-color: var(--ink);
  }
  .designed.special {
    background: var(--white);
  }
  .wordmark {
    font-size: 13cqi;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    padding-bottom: 3%;
    border-bottom: 1px solid currentColor;
    font-size: 3.6cqi;
    font-weight: 600;
  }
  .panel {
    flex: 1;
    border: 1px solid var(--ink);
    background:
      linear-gradient(to right, rgb(10 10 10 / 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(10 10 10 / 0.08) 1px, transparent 1px);
    background-size: 8% 8%;
  }
  .title {
    font-size: 7cqi;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
</style>
