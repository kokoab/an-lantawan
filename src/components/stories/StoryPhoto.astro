---
import type { StorySummary } from '../../db/queries/stories';
import { focalClasses, mediaUrl, showWhole } from '../../lib/urls';

interface Props {
  cover: StorySummary['cover'];
  class?: string;
  /** The first photo on a page loads right away; the rest load as they scroll in. */
  eager?: boolean;
  /** Set when the frame already matches the picture's shape, so it never needs letterboxing. */
  fitted?: boolean;
}

const { cover, class: className, eager = false, fitted = false } = Astro.props;
---

<div class:list={['photo', className, !fitted && cover && showWhole(cover) && 'whole']}>
  {
    cover && (
      <img
        src={mediaUrl(cover.key)}
        alt={cover.alt ?? ''}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
        class={focalClasses(cover)}
      />
    )
  }
</div>
