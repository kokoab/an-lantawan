---
/** A story in a list: a photo card on wide screens, a compact row with a thumbnail on phones. */
import type { StorySummary } from '../../db/queries/stories';
import { formatDate, isoDate } from '../../lib/format';
import { storyUrl } from '../../lib/urls';
import StoryPhoto from './StoryPhoto.astro';

interface Props {
  story: StorySummary;
}

const { story } = Astro.props;
const label = story.kind === 'explainer' ? 'Explainer' : story.section.name;
---

<article class="card">
  <a href={storyUrl(story)}>
    <StoryPhoto cover={story.cover} class="card-photo" />
    <div class="text">
      <p class="label">{label}</p>
      <h3>{story.title}</h3>
      <time datetime={isoDate(story.publishedAt)}>{formatDate(story.publishedAt)}</time>
    </div>
  </a>
</article>

<style>
  .card > a {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: 16px;
  }
  .card :global(.card-photo) {
    flex: none;
    width: 88px;
    height: 88px;
  }
  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .label,
  time {
    margin: 0;
    font-size: 13px;
    line-height: 16px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
  }
  .label {
    font-weight: 500;
  }
  h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    line-height: 25px;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }

  @media (min-width: 768px) {
    .card > a {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
    .card :global(.card-photo) {
      width: 100%;
      height: auto;
      aspect-ratio: 389 / 340;
    }
    .text {
      gap: 8px;
    }
    .label,
    time {
      font-size: 14px;
      line-height: 18px;
    }
    h3 {
      font-size: clamp(22px, 2.1vw, 30px);
      line-height: 1.2;
      letter-spacing: -0.03em;
    }
  }
</style>
