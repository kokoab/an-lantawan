---
/**
 * A story in a list. `responsive` is a photo card on wide screens and a compact row with a
 * thumbnail on phones; `compact` and `card` keep one layout at every width.
 */
import type { StorySummary } from '../../db/queries/stories';
import { formatDate, isoDate } from '../../lib/format';
import { storyLabel, storyUrl } from '../../lib/urls';
import StoryPhoto from './StoryPhoto.astro';

interface Props {
  story: StorySummary;
  variant?: 'responsive' | 'compact' | 'card';
}

const { story, variant = 'responsive' } = Astro.props;
const label = storyLabel(story);
---

<article class:list={['card', `is-${variant}`]}>
  <a href={storyUrl(story)}>
    <StoryPhoto cover={story.cover} class="card-photo" />
    <div class="text">
      <p class="label">{label}</p>
      <h3>{story.title}</h3>
      <time datetime={isoDate(story.publishedAt)}>{formatDate(story.publishedAt)}</time>
    </div>
  </a>
</article>

<style>
  .card > a {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: 16px;
  }
  .card :global(.card-photo) {
    flex: none;
    width: 88px;
    height: 88px;
  }
  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .label,
  time {
    margin: 0;
    font-size: 13px;
    line-height: 16px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
  }
  .label {
    font-weight: 500;
  }
  h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    line-height: 25px;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }

  /* Large photo card: always for `card`, from tablet width for `responsive`. */
  .is-card > a {
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
  }
  .is-card :global(.card-photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 389 / 340;
  }
  .is-card .text {
    gap: 8px;
  }
  .is-card .label,
  .is-card time {
    font-size: 14px;
    line-height: 18px;
  }
  .is-card h3 {
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  @media (min-width: 768px) {
    .is-responsive > a {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
    .is-responsive :global(.card-photo) {
      width: 100%;
      height: auto;
      aspect-ratio: 389 / 340;
    }
    .is-responsive .text {
      gap: 8px;
    }
    .is-responsive .label,
    .is-responsive time {
      font-size: 14px;
      line-height: 18px;
    }
    .is-responsive h3 {
      font-size: clamp(22px, 2.1vw, 30px);
      line-height: 1.2;
      letter-spacing: -0.03em;
    }
  }
</style>
