---
/** Section head, lead story, story grid and pagination: News, Opinion, Features, Sports and All stories. */
import type { StorySummary } from '../../db/queries/stories';
import PageHead from '../site/PageHead.astro';
import LeadStory from './LeadStory.astro';
import Pagination from './Pagination.astro';
import StoryCard from './StoryCard.astro';

interface Props {
  title: string;
  intro: string | null;
  /** The filter row: All stories plus each top-level section. */
  filters: Array<{ label: string; href: string; current: boolean }>;
  lead: StorySummary | null;
  grid: StorySummary[];
  total: number;
  page: number;
  pages: number;
  pageHref: (page: number) => string;
}

const { title, intro, filters, lead, grid, total, page, pages, pageHref } = Astro.props;
const shown = (lead ? 1 : 0) + grid.length;
---

<PageHead title={title} intro={intro} filters={filters} filtersLabel="Sections" />

<slot name="after-head" />

{lead && <LeadStory story={lead} />}

{
  total === 0 ? (
    <section class="band framed stories">
      <div class="empty">
        <h2>No stories here yet</h2>
        <p>New stories in {title} will show up here as soon as they're published.</p>
        <a class="btn btn-secondary" href="/">Go to the homepage</a>
      </div>
    </section>
  ) : (
    grid.length > 0 && (
      <section class="band framed stories" aria-labelledby="stories-title">
        <div class="stories-head">
          <h2 id="stories-title">{page === 1 ? 'Earlier stories' : `Page ${page}`}</h2>
          <p>
            Showing {shown} of {total}
          </p>
        </div>
        <div class="grid">
          {grid.map((s) => (
            <StoryCard story={s} />
          ))}
        </div>
        <Pagination page={page} pages={pages} href={pageHref} />
      </section>
    )
  )
}

<style>
  .stories {
    padding-block: 48px 96px;
  }
  .stories-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 24px;
  }
  .stories-head h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    line-height: 28px;
    letter-spacing: -0.03em;
  }
  .stories-head p {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
    white-space: nowrap;
  }
  /* Rows are separated by a rule; lines run into the gaps and are clipped at the edges. */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 24px;
    overflow: hidden;
  }
  .grid > :global(*) {
    position: relative;
    padding-block: 20px;
  }
  .grid > :global(*)::before {
    content: '';
    position: absolute;
    top: 0;
    left: -24px;
    right: -24px;
    border-top: 1px solid var(--grey-300);
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding-block: 32px;
    border-top: 1px solid var(--grey-300);
  }
  .empty h2 {
    margin: 0;
    font-size: 24px;
    line-height: 28px;
    letter-spacing: -0.03em;
  }
  .empty p {
    margin: 0 0 8px;
    color: var(--grey-600);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid > :global(*) {
      padding-block: 32px;
    }
  }

  @media (min-width: 1024px) {
    .stories {
      padding-block: 64px 128px;
    }
    .stories-head h2 {
      font-size: 28px;
      line-height: 32px;
    }
    .stories-head p {
      font-size: 15px;
    }
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
