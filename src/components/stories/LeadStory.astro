---
/** The newest story of a list, shown large above the grid. */
import type { StorySummary } from '../../db/queries/stories';
import { formatDate, isoDate } from '../../lib/format';
import { storyLabel, storyUrl } from '../../lib/urls';
import StoryPhoto from './StoryPhoto.astro';

interface Props {
  story: StorySummary;
}

const { story } = Astro.props;
const label = storyLabel(story);
const href = storyUrl(story);
---

<section class="band framed lead" aria-labelledby="lead-title">
  <div class="inner">
    <a class="lead-photo-link" href={href} tabindex="-1" aria-hidden="true">
      <StoryPhoto cover={story.cover} class="lead-photo" eager />
    </a>
    <div class="text">
      <span class="pill">{label}</span>
      <h2 id="lead-title"><a href={href}>{story.title}</a></h2>
      {story.dek && <p class="dek">{story.dek}</p>}
      <time datetime={isoDate(story.publishedAt)}>{formatDate(story.publishedAt)}</time>
      <a class="btn btn-primary read" href={href}>Read the story</a>
    </div>
  </div>
</section>

<style>
  .lead {
    padding-block: 48px 66px;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lead :global(.lead-photo) {
    width: 100%;
    aspect-ratio: 342 / 220;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  h2 {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    line-height: 34px;
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }
  h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }
  .dek {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
  }
  time {
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
  }
  .read {
    align-self: stretch;
  }

  @media (min-width: 1024px) {
    .lead {
      padding-block: 64px 128px;
    }
    .inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 48px;
    }
    .lead-photo-link {
      flex: 0 0 calc((100% - 48px) * 768 / 1168);
    }
    .lead :global(.lead-photo) {
      aspect-ratio: 16 / 9;
    }
    .text {
      flex: 1;
      gap: 20px;
    }
    h2 {
      font-size: 36px;
      line-height: 40px;
    }
    .dek {
      font-size: 18px;
      line-height: 27px;
    }
    time {
      font-size: 14px;
      line-height: 18px;
    }
    .read {
      align-self: flex-start;
      margin-top: 4px;
    }
  }
</style>
