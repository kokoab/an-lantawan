---
import type { StorySummary } from '../../db/queries/stories';
import StoryCard from '../stories/StoryCard.astro';

interface Props {
  stories: StorySummary[];
}

const { stories } = Astro.props;
// Newest stories after the lead and the Latest list, three rows of three.
---

<section class="band framed more" aria-labelledby="more-title">
  <div class="head">
    <h2 id="more-title">More stories</h2>
    <a class="btn btn-secondary" href="/stories">All stories</a>
  </div>
  <div class="cards">
    {stories.map((s) => <StoryCard story={s} />)}
  </div>
</section>

<style>
  .more {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: 64px 72px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  h2 {
    margin: 0;
    font-size: 36px;
    font-weight: 700;
    line-height: 40px;
    letter-spacing: -0.04em;
  }
  /* Rows are ruled like the section pages; lines run into the gaps and are clipped. */
  .cards {
    display: grid;
    column-gap: 24px;
    overflow: hidden;
  }
  .cards > :global(*) {
    position: relative;
    padding-block: 20px;
  }
  .cards > :global(*)::before {
    content: '';
    position: absolute;
    top: 0;
    left: -24px;
    right: -24px;
    border-top: 1px solid var(--grey-300);
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .cards > :global(*) {
      padding-block: 32px;
    }
  }
  @media (min-width: 1024px) {
    .more {
      gap: 36px;
      padding-block: 104px 146px;
    }
    h2 {
      font-size: 56px;
      line-height: 58px;
    }
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
