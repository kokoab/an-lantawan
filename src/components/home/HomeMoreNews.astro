---
import type { StorySummary } from '../../db/queries/stories';
import StoryCard from '../stories/StoryCard.astro';

interface Props {
  stories: StorySummary[];
}

const { stories } = Astro.props;
---

<section class="band framed more" aria-labelledby="more-news-title">
  <div class="head">
    <h2 id="more-news-title">More news</h2>
    <a class="btn btn-secondary" href="/news">All news</a>
  </div>
  <div class="cards">
    {stories.map((s) => <StoryCard story={s} variant="card" />)}
  </div>
</section>

<style>
  .more {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: 64px 72px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  h2 {
    margin: 0;
    font-size: 36px;
    font-weight: 700;
    line-height: 40px;
    letter-spacing: -0.04em;
  }
  .cards {
    display: grid;
    gap: 40px 24px;
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .more {
      gap: 36px;
      padding-block: 104px 146px;
    }
    h2 {
      font-size: 56px;
      line-height: 58px;
    }
    .cards :global(.card-photo) {
      aspect-ratio: 592 / 340;
    }
  }
</style>
