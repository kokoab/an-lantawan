---
/** The black Opinion block: the newest opinion piece large, three more below. */
import type { StorySummary } from '../../db/queries/stories';
import { formatDate } from '../../lib/format';
import { storyLabel, storyUrl } from '../../lib/urls';
import StoryPhoto from '../stories/StoryPhoto.astro';

type Piece = StorySummary & { writers: string[] };

interface Props {
  intro: string | null;
  pieces: Piece[];
}

const { intro, pieces } = Astro.props;
const [featured, ...more] = pieces;

const label = (p: Piece) =>
  p.kind === 'opinion' || p.kind === 'article' ? 'Opinion' : storyLabel(p);
const byline = (p: Piece) => {
  const date = formatDate(p.publishedAt);
  if (p.writers.length) return `By ${p.writers.join(' and ')}, ${date}`;
  return p.kind === 'editorial' ? `The editorial board, ${date}` : date;
};
---

<div class="wrap">
  <section class="band opinion" aria-labelledby="opinion-title">
    <div class="head">
      <h2 id="opinion-title">Opinion</h2>
      {intro && <p>{intro}</p>}
    </div>

    {
      featured && (
        <article class:list={['featured', !featured.cover && 'text-only']}>
          {featured.cover && (
            <a class="cartoon" href={storyUrl(featured)} tabindex="-1" aria-hidden="true">
              <StoryPhoto cover={featured.cover} class="cartoon-photo" />
            </a>
          )}
          <div class="text">
            <p class="kind">{label(featured)}</p>
            <h3>
              <a href={storyUrl(featured)}>{featured.title}</a>
            </h3>
            {featured.dek && <p class="dek">{featured.dek}</p>}
            <p class="byline">{byline(featured)}</p>
          </div>
        </article>
      )
    }

    {
      more.length > 0 && (
        <div class="more">
          {more.map((p) => (
            <a class="item" href={storyUrl(p)}>
              <span class="kind">{label(p)}</span>
              <span class="item-title">{p.title}</span>
              <span class="item-byline">{byline(p)}</span>
            </a>
          ))}
        </div>
      )
    }

    <a class="btn all" href="/opinion">All opinion</a>
  </section>
</div>

<style>
  .wrap {
    padding-bottom: 2px;
  }
  .opinion {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 48px 56px;
    background-color: var(--ink);
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: var(--module) var(--module);
    background-position: var(--grid-x) 0;
    color: var(--white);
  }
  p,
  h2,
  h3 {
    margin: 0;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h2 {
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .head p {
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.01em;
    color: var(--grey-300);
  }
  .featured {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .featured :global(.cartoon-photo) {
    aspect-ratio: 600 / 460;
    border-color: #1e1e1c;
    background: #1e1e1c;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .kind {
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    letter-spacing: -0.01em;
    color: var(--grey-300);
  }
  h3 {
    font-size: 34px;
    font-weight: 700;
    line-height: 38px;
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }
  h3 a:hover,
  .item:hover .item-title {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }
  .dek {
    font-size: 17px;
    line-height: 26px;
    letter-spacing: -0.01em;
    color: var(--grey-300);
  }
  .byline {
    font-size: 15px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: -0.01em;
  }
  .more {
    display: grid;
    gap: 24px;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 24px;
    border-top: 1px solid var(--grey-600);
  }
  .item-title {
    font-size: 22px;
    font-weight: 600;
    line-height: 28px;
    letter-spacing: -0.02em;
  }
  .item-byline {
    font-size: 15px;
    line-height: 20px;
    letter-spacing: -0.01em;
    color: var(--grey-300);
  }
  .all {
    align-self: stretch;
    background: var(--white);
    color: var(--ink);
  }
  .all:hover {
    background: var(--grey-100);
  }

  @media (min-width: 1024px) {
    .opinion {
      gap: 56px;
      padding-block: 56px 79px;
    }
    .head {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 48px;
    }
    h2 {
      font-size: 104px;
      line-height: 100px;
    }
    .head p {
      width: 380px;
      font-size: 17px;
      line-height: 26px;
    }
    .featured {
      flex-direction: row;
      align-items: center;
      gap: 48px;
    }
    .cartoon {
      flex: 0 0 calc((100% - 48px) * 600 / 1168);
    }
    .text {
      flex: 1;
      gap: 20px;
    }
    .kind {
      font-size: 15px;
      line-height: 20px;
    }
    .text-only .text {
      max-width: 820px;
    }
    h3 {
      font-size: 52px;
      line-height: 56px;
    }
    .dek {
      font-size: 20px;
      line-height: 30px;
    }
    .more {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
    .item-title {
      font-size: 24px;
      line-height: 30px;
    }
    .all {
      align-self: flex-start;
    }
  }
</style>
