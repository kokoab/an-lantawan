---
/** The lead story beside the Latest list. On phones, Latest becomes its own band below. */
import type { StorySummary } from '../../db/queries/stories';
import { formatDate, isoDate } from '../../lib/format';
import { storyLabel, storyUrl } from '../../lib/urls';
import StoryCard from '../stories/StoryCard.astro';
import StoryPhoto from '../stories/StoryPhoto.astro';

interface Props {
  lead: StorySummary;
  minutes: number | null;
  latest: StorySummary[];
}

const { lead, minutes, latest } = Astro.props;
const href = storyUrl(lead);
const isExplainer = lead.kind === 'explainer';
---

<section class="band framed hero">
  <article class="lead">
    <a class="lead-photo-link" href={href} tabindex="-1" aria-hidden="true">
      <StoryPhoto cover={lead.cover} class="lead-photo" eager />
    </a>
    <div class="text">
      <span class="pill">{storyLabel(lead)}</span>
      <h1><a href={href}>{lead.title}</a></h1>
      {lead.dek && <p class="dek">{lead.dek}</p>}
      <p class="meta">
        <time datetime={isoDate(lead.publishedAt)}>{formatDate(lead.publishedAt)}</time>
        {minutes && <span>{minutes}-minute read</span>}
      </p>
      <a class="btn btn-primary cta" href={href}>{isExplainer ? 'Read the explainer' : 'Read the story'}</a>
    </div>
  </article>

  <aside class="latest" aria-labelledby="latest-title">
    <div class="latest-head">
      <h2 id="latest-title">Latest</h2>
      <a class="btn btn-secondary" href="/stories">All stories</a>
    </div>
    <div class="list">
      {latest.map((s) => <StoryCard story={s} variant="compact" />)}
    </div>
  </aside>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    padding: 0 0 69px;
  }
  .hero.framed::after {
    display: none;
  }
  .lead {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero :global(.lead-photo) {
    height: 260px;
    border: 0;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-inline: 16px;
  }
  .pill {
    padding: 6px 12px;
    font-size: 13px;
    line-height: 16px;
  }
  h1 {
    margin: 0;
    font-size: 34px;
    font-weight: 700;
    line-height: 37px;
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }
  h1 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }
  .dek {
    margin: 0;
    font-size: 17px;
    line-height: 25px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
  }
  .meta {
    display: flex;
    gap: 16px;
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: -0.01em;
    color: var(--grey-600);
  }
  .cta {
    align-self: stretch;
    margin-top: 6px;
    padding-block: 16px;
  }

  .latest {
    margin-top: 69px;
    padding: 32px var(--gutter) 0;
    border-top: 1px solid var(--grey-300);
  }
  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0 20px;
  }
  h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    line-height: 32px;
    letter-spacing: -0.03em;
  }
  .list > :global(*) {
    padding-block: 20px;
    border-top: 1px solid var(--grey-300);
  }

  @media (min-width: 1024px) {
    .hero {
      flex-direction: row;
      align-items: flex-start;
      gap: 24px;
      padding: 56px var(--gutter) 71px;
    }
    .hero.framed::after {
      display: block;
    }
    .lead {
      flex: 1;
      min-width: 0;
      gap: 28px;
    }
    .hero :global(.lead-photo) {
      height: auto;
      aspect-ratio: 792 / 392;
      border: 1px solid var(--grey-300);
    }
    .text {
      gap: 18px;
      padding-inline: 0;
    }
    .pill {
      padding: 7px 14px;
      font-size: 14px;
      line-height: 18px;
    }
    h1 {
      max-width: 820px;
      font-size: 56px;
      line-height: 58px;
    }
    .dek {
      font-size: 20px;
      line-height: 29px;
    }
    .meta {
      gap: 20px;
      font-size: 14px;
      line-height: 18px;
    }
    .cta {
      align-self: flex-start;
      padding-block: 14px;
    }
    .latest {
      flex: 0 0 400px;
      margin: 0;
      padding: 0;
      border: 0;
    }
  }
</style>
