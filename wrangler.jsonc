{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "an-lantawan",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Public values only. Secrets (GOOGLE_CLIENT_SECRET, TURNSTILE_SECRET) are set with
  // `wrangler secret put` and never committed.
  "vars": {
    "GOOGLE_CLIENT_ID": "105816458039-5gu3i1r8lcvliqv3iocju0cqnatim15d.apps.googleusercontent.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFwU61vRquUhAg04"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "an-lantawan",
      "database_id": "4069612d-4dfb-49c5-878e-c9c04083ed46",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "an-lantawan-media"
    }
  ],
  // Per-visitor limits, counted in Cloudflare's memory. Nothing about the visitor is stored.
  "ratelimits": [
    { "name": "SUMAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
}
