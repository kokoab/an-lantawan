    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "arctic": "^3.7.0",
    "astro": "^7.4.4",
    "drizzle-orm": "^0.45.4",
    "image-size": "^2.0.4",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "domhandler": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "entities": "^9.0.0",
