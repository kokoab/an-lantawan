{
  "name": "an-lantawan",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && biome check .",
